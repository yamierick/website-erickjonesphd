---
// Port of the Hugo theme's baseof.html. Markup and class names are kept
// identical so public/css/main.css applies unchanged, and so the 14
// pass-through R-Markdown pages in public/resources/ (which were rendered by
// Hugo against this same stylesheet) stay visually consistent with the site.
// Markdown pages pass their front matter under `frontmatter`; .astro pages pass
// props directly. Accept both so one layout serves the whole site.
const fm = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? fm.title;
const description =
  Astro.props.description ??
  fm.description ??
  "Assistant Professor, Industrial, Manufacturing, and Systems Engineering, UT Arlington. Building the future of energy and critical mineral systems — end to end and back.";
const wide = Astro.props.wide ?? fm.wide ?? false;
// The Hugo home template printed a hero above the content; ordinary pages
// printed an <h1> of the title inside an <article>.
const isHome = Astro.props.home ?? fm.home ?? false;
const portrait = Astro.props.portrait ?? fm.portrait ?? null;
const portraitAlt = Astro.props.portraitAlt ?? fm.portraitAlt ?? "";

// Social card. Pages name one of the PNGs in /img/og/; everything else gets
// the site-wide card. These are generated by a script rather than screenshotted
// — see the commit that added them — so regenerating one is a re-run, not a
// design session.
const ogName = Astro.props.og ?? fm.og ?? "default";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`/img/og/${ogName}.png`, Astro.site).href;
const tagline = "Building the Future of Energy and Critical Mineral Systems — End to End and Back";
const subhead = "Physical, digital, and institutional — the three layers of the infrastructure of the future.";

const siteTitle = "Erick C. Jones Jr., Ph.D.";
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const nav = [
  { name: "About", url: "/about/" },
  { name: "Research", url: "/research/" },
  { name: "Labs", url: "/labs/" },
  { name: "Publications", url: "/publications/" },
  { name: "Teaching", url: "/teaching/" },
  { name: "Resources", url: "/resources/" },
  { name: "Models", url: "/models/" },
  { name: "Beyond", url: "/beyond/" },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{pageTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>

{/* Open Graph and Twitter. Without these a shared link previews as a bare URL,
    which is most of what a link does before anyone clicks it. */}
<meta property="og:type" content="website">
<meta property="og:site_name" content={siteTitle}>
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={pageTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
{/* Tab icon only — a flat "EJ" monogram on the site's green. The header bar
    stays as the name in text; the favicon is never shown in the page itself. */}
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/png" href="/img/favicon-32.png" sizes="32x32">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<link rel="stylesheet" href="/css/main.css">
{/* A style tag is raw text in Astro -- expressions inside it are NOT
    evaluated -- so the interpolated form of this rule emitted its own source
    code as invalid CSS, and `wide` silently did nothing on every page that
    asked for it. Static rule, class on the element, no interpolation to get
    wrong. */}
<style is:global>
  /* `wide` widens the COLUMN, not the prose. Running body text to 62rem is
     hard to read, and the pages that ask for wide only want it for a chart or
     a diagram -- so the text blocks stay at the reading measure and anything
     else is free to use the full width. */
  main.wide { max-width: 62rem; }
  main.wide > article > p,
  main.wide > article > h1,
  main.wide > article > h2,
  main.wide > article > h3,
  main.wide > article > ul,
  main.wide > article > ol,
  main.wide > article > blockquote { max-width: var(--max); }
</style>
</head>
<body>
<header class="site-header">
  <a class="site-title" href="/">Erick C. Jones Jr.</a>
  <nav>
    {nav.map((n) => <a href={n.url}>{n.name}</a>)}
  </nav>
</header>
<main class={wide ? "wide" : undefined}>
  {isHome ? (
    <>
      <section class={portrait ? "hero hero-portrait" : "hero"}>
        {portrait && <img class="portrait" src={portrait} alt={portraitAlt} width="140" height="140">}
        <div>
          <h1>{tagline}</h1>
          <p class="subhead">{subhead}</p>
        </div>
      </section>
      <slot />
    </>
  ) : (
    <article>
      {title && <h1>{title}</h1>}
      <slot />
    </article>
  )}
</main>
<footer class="site-footer">
  <p>
    <a href="mailto:erick.jones@uta.edu">erick.jones@uta.edu</a> ·
    <a href="https://scholar.google.com/citations?hl=en&user=03RL76wAAAAJ">Google Scholar</a> ·
    <a href="https://www.linkedin.com/in/erickjones2/">LinkedIn</a> ·
    <a href="https://github.com/yamierick">GitHub</a> ·
    <a href="https://searlab.uta.edu/">SEAR Lab</a>
  </p>
  <p class="constellation">Professional site · <a href="https://engineerliving.com">Engineer Living (ideas &amp; writing)</a> · <em>The Friction Deficit</em> (fiction, coming soon)</p>
</footer>
</body>
</html>
