---
/**
 * The interactive cascade: controls, two annual bars, a day, and the flow
 * diagram, with the readout and numbers table beneath them.
 *
 * Rendered twice -- inside the site at /materials/, and bare at
 * /embed/materials/ for the lab site to put in an iframe -- which is why it is
 * a component rather than a page.
 *
 * Two timescales, kept deliberately apart because mixing them is the mistake
 * an earlier draft made:
 *
 *   THE YEAR, in terawatt-hours. Energy served by technology, landing exactly
 *   on a dashed box at annual demand; the same fleet run flat out for all
 *   8,760 hours, overshooting it. The gap is energy NEVER GENERATED -- night,
 *   calm, idle plant -- and is labelled as such. It is not curtailment and not
 *   charging loss: those are real but run five to fifteen percent of
 *   generation, where this gap is two hundred.
 *
 *   ONE DAY, in gigawatt-hours. An illustrative load curve, and beneath it the
 *   share of a day's demand the battery carries. The curve is a schematic and
 *   inert; the bar is model output and live. The caption says which is which,
 *   and that distinction is load-bearing -- the model has no time resolution,
 *   so the curve is the one thing on the page it could not have computed.
 */
---

<div class="cascade">
  <div class="controls">
    <fieldset>
      <legend>Scenario</legend>
      <div class="scen" id="scen">
        <button type="button" data-v="gas" >Gas-heavy</button>
        <button type="button" data-v="balanced" class="on">Balanced</button>
        <button type="button" data-v="solar">Solar + storage</button>
        <button type="button" data-v="wind">Wind-heavy</button>
      </div>
      <p class="hint" id="scen-hint"></p>
    </fieldset>

    <fieldset>
      <legend>Demand</legend>
      <label>Load growth <output data-for="demandGrowth"></output>
        <input type="range" id="demandGrowth" min="0" max="40" step="1" value="20">
      </label>
    </fieldset>

    <fieldset>
      <legend>Mix in ten years</legend>
      <label>Gas share <output data-for="gasShare"></output>
        <input type="range" id="gasShare" min="0" max="90" step="5" value="30">
      </label>
      <p class="hint" id="mix-hint"></p>
    </fieldset>

    <fieldset>
      <legend>Storage</legend>
      <label>Built per GW of wind + solar <output data-for="storageHours"></output>
        <input type="range" id="storageHours" min="0" max="8" step="1" value="3">
      </label>
      <label>LFP share of cells <output data-for="lfpShare"></output>
        <input type="range" id="lfpShare" min="0" max="100" step="5" value="60">
      </label>
    </fieldset>

    <fieldset>
      <legend>Period</legend>
      <div class="seg" id="period">
        <button type="button" data-v="0">Today</button>
        <button type="button" data-v="1">+5 yr</button>
        <button type="button" data-v="2" class="on">+10 yr</button>
      </div>
      <p class="hint" id="period-hint"></p>
    </fieldset>

    <div class="actions">
      <button type="button" id="reset" class="reset">Reset</button>
      <button type="button" id="share" class="reset">Copy link</button>
    </div>
  </div>

  <div class="output">
    <p class="tier-head">Over a year</p>

    <figure class="mult">
      <svg id="mult" viewBox="0 0 760 110" role="img" aria-labelledby="mult-title mult-desc">
        <title id="mult-title">Energy served against the same fleet run flat out, per year</title>
        <desc id="mult-desc"></desc>
      </svg>
      <figcaption id="mult-cap"></figcaption>
    </figure>

    <p class="tier-head">Over one day</p>

    <figure class="schematic">
      <svg id="schematic" viewBox="0 0 760 124" role="img" aria-labelledby="sch-title sch-desc">
        <title id="sch-title">Schematic of a day: surplus solar charging storage</title>
        <desc id="sch-desc">An illustrative diagram, not model output. A dashed
          demand curve across one day with a morning ramp and an evening peak,
          and a solar curve that rises above it in the middle of the day. The
          area where solar exceeds demand is shaded as surplus charging the
          battery; the evening peak after sunset is shaded as the battery
          discharging. There are no values on either axis because the model has
          no time resolution and did not compute this.</desc>
      </svg>
      <figcaption>
        <strong>The curve is a schematic — not model output.</strong> The model
        has no time resolution: one annual figure per technology is the whole of
        it. The shapes are illustrative and do not respond to the controls, which
        is the honest signal. The bar below it is a different thing: real model
        output, and it does respond.
      </figcaption>
    </figure>

    <figure class="dayfig">
      <svg id="storageday" viewBox="0 0 760 56" role="img" aria-labelledby="day-title day-desc">
        <title id="day-title">Share of one day's demand the battery carries</title>
        <desc id="day-desc"></desc>
      </svg>
      <figcaption id="day-cap"></figcaption>
    </figure>

    <div id="flow-wrap">
      <svg id="flow" viewBox="0 0 760 440" role="img" aria-labelledby="flow-title flow-desc">
        <title id="flow-title">Material flow from ore mined to capacity built</title>
        <desc id="flow-desc"></desc>
      </svg>
      <div class="legend" id="legend"></div>
    </div>

    <dl class="readout" id="readout"></dl>

    <details class="numbers" id="numbers">
      <summary id="numbers-summary">Show the numbers</summary>
      <div id="tables"></div>
    </details>
  </div>
</div>

<style>
  .cascade {
    display: grid;
    grid-template-columns: 15rem 1fr;
    gap: 1.5rem;
    margin: 1.5rem 0;

    /* Spread by lightness as well as hue, and every entry clears 3:1 against
       its own background -- which is the constraint that actually binds.
       Requiring that of five colours confines them to a narrow lightness band
       (below L=0.30 on white, above L=0.16 on the dark ground), and inside
       that band the best achievable contrast between ADJACENT pairs is about
       1.5:1. Measured, not guessed: an earlier attempt at "just separate the
       lightness" scored 1.02 between copper and nickel, worse than what it
       replaced.

       So colour cannot be made sufficient here, and is not asked to be. The
       ore links carry their multiplier as text, every column node is labelled,
       and the table below states all of it in words. That redundancy is the
       accessibility mechanism; the palette is only there to help the reader
       who can already see it. Do not "fix" this by flattening the hues. */
    --m-copper: #9c4f1c;
    --m-aluminum: #7b8b96;
    --m-steel: #39424b;
    --m-lithium: #0f7a58;
    --m-nickel: #6b2e99;

    /* Technology identity -- a second, deliberately different colour family
       from the materials above, so a reader never has to ask "orange because
       copper, or orange because gas?". Chosen the same way as the material
       palette: every one clears 3:1 against the page background in both
       themes (computed, not eyeballed). Grid stays uncoloured (var(--text)):
       it is the interconnection, not a generation technology, and that
       distinction is worth keeping visible. */
    --t-gas: #93241a;
    --t-solar: #93771a;
    --t-wind: #1a7b93;
    --t-storage: #931a93;
  }
  @media (prefers-color-scheme: dark) {
    .cascade {
      --m-copper: #f0b57e;
      --m-aluminum: #cdd8de;
      --m-steel: #6b7682;
      --m-lithium: #34ab80;
      --m-nickel: #c99ae9;

      --t-gas: #e47267;
      --t-solar: #e4c767;
      --t-wind: #67cbe4;
      --t-storage: #e467e4;
    }
  }
  @media (max-width: 820px) { .cascade { grid-template-columns: 1fr; } }

  .controls fieldset {
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: .6rem .8rem .8rem;
    margin: 0 0 .8rem;
  }
  .controls legend {
    font-family: system-ui, sans-serif;
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--accent);
    padding: 0 .3rem;
  }
  .controls label {
    display: block;
    font-family: system-ui, sans-serif;
    font-size: .82rem;
    color: var(--muted);
    margin-top: .5rem;
  }
  .controls input[type=range] { width: 100%; margin-top: .2rem; accent-color: var(--accent); }
  .controls output { float: right; font-variant-numeric: tabular-nums; color: var(--text); }

  .seg, .scen { display: flex; gap: .25rem; }
  .scen { flex-wrap: wrap; }
  .scen button { flex: 1 1 45%; }
  .seg button, .scen button {
    font: inherit;
    font-family: system-ui, sans-serif;
    font-size: .78rem;
    padding: .3rem .2rem;
    background: var(--bg);
    color: var(--muted);
    border: 1px solid var(--rule);
    border-radius: 4px;
    cursor: pointer;
  }
  .seg button.on, .scen button.on { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .actions { display: flex; gap: .4rem; }
  .reset {
    font-family: system-ui, sans-serif;
    font-size: .8rem;
    background: none;
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: .3rem .7rem;
    color: var(--muted);
    cursor: pointer;
  }
  .hint { font-family: system-ui, sans-serif; font-size: .76rem; color: var(--muted); margin: .5rem 0 0; }

  #flow, #mult { width: 100%; height: auto; display: block; }

  .mult { margin: 0 0 1rem; }
  .mult figcaption {
    font-family: system-ui, sans-serif; font-size: .78rem; color: var(--muted); margin-top: .2rem;
  }

  .tier-head {
    font-family: system-ui, sans-serif; font-size: .72rem; text-transform: uppercase;
    letter-spacing: .08em; color: var(--accent); margin: .2rem 0 .4rem;
    border-bottom: 1px solid var(--rule); padding-bottom: .25rem;
  }
  .schematic { margin: .25rem 0 .5rem; }
  .dayfig { margin: 0 0 1rem; }
  .dayfig figcaption {
    font-family: system-ui, sans-serif; font-size: .78rem; color: var(--muted); margin-top: .2rem;
  }
  .schematic figcaption {
    font-family: system-ui, sans-serif; font-size: .76rem; color: var(--muted);
    margin-top: .2rem; border-left: 2px solid var(--rule); padding-left: .6rem;
  }
  .schematic figcaption strong { color: var(--text); }

  .numbers { margin-top: 1rem; }
  .numbers summary {
    font-family: system-ui, sans-serif; font-size: .82rem; color: var(--accent);
    cursor: pointer; padding: .3rem 0;
  }

  /* Below this width the flow diagram is not merely cramped, it is unreadable:
     a four-column diagram with twenty-one labels renders its type at about
     five pixels on a phone. The table is not a fallback here -- it is the
     better view, so the diagram gets out of its way. */
  @media (max-width: 600px) {
    /* The schematic goes too: at 375px its type lands around five pixels, the
       same reason the flow diagram and the bars step aside. Its caption is
       the whole point anyway -- the diagram illustrates a sentence, and the
       sentence survives on its own. */
    #flow-wrap, #mult, #schematic, #storageday { display: none; }
    .numbers summary { display: none; }
    /* The captions stay. They are what the bars were drawing, and the
       capacity table below carries the numbers they were drawing them from. */
    .mult figcaption { margin-top: 0; }
    .schematic { margin-top: 0; }
  }
</style>

<style is:global>
  /* These rules target elements the script creates at runtime. Astro scopes
     component styles with a data attribute that only markup gets, so a
     scoped rule silently never matches a JS-built node -- which is how the
     readout boxes, the legend swatches and every diagram transition came
     out unstyled. Global, but held under .cascade so nothing escapes. */
  .cascade #flow .ribbon { transition: d .45s ease, opacity .45s ease; }
  .cascade #flow .node { transition: y .45s ease, height .45s ease; }
  .cascade #flow .nlabel { transition: transform .45s ease, opacity .45s ease; }
  @media (prefers-reduced-motion: reduce) {
    .cascade #flow .ribbon, .cascade #flow .node, .cascade #flow .nlabel { transition: none; }
  }

  .cascade .legend {
    display: flex; flex-wrap: wrap; gap: .2rem 1rem;
    font-family: system-ui, sans-serif; font-size: .78rem; color: var(--muted);
    margin-top: .5rem;
  }
  .cascade .legend .sw { display: inline-block; width: .7rem; height: .7rem; margin-right: .3rem; vertical-align: -1px; border-radius: 2px; }
  .cascade .legend .scale-note { flex-basis: 100%; font-size: .74rem; opacity: .85; }
  .cascade .legend .legend-group {
    font-weight: 600; color: var(--text); margin-left: .4rem;
  }
  .cascade .legend .legend-group:first-child { margin-left: 0; }

  .cascade .readout {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: .6rem; margin: 1rem 0 0;
    font-family: system-ui, sans-serif;
  }
  .cascade .readout div { border: 1px solid var(--rule); border-radius: 6px; padding: .5rem .7rem; }
  .cascade .readout div.wide { grid-column: 1 / -1; border-color: var(--accent); }
  .cascade .readout dt { font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
  .cascade .readout dd { margin: .15rem 0 0; font-size: 1.15rem; font-variant-numeric: tabular-nums; }
  .cascade .readout dd small { font-size: .8rem; color: var(--muted); font-variant-numeric: normal; }

  .cascade #mult .bar { transition: x .45s ease, width .45s ease; }
  .cascade #mult .tie { transition: d .45s ease; }
  @media (prefers-reduced-motion: reduce) {
    .cascade #mult .bar, .cascade #mult .tie { transition: none; }
  }

  .cascade .numbers .tw { overflow-x: auto; }
  .cascade .numbers table {
    width: 100%; min-width: 28rem; border-collapse: collapse; margin: .6rem 0 1rem;
    font-family: system-ui, sans-serif; font-size: .82rem;
    font-variant-numeric: tabular-nums;
  }
  .cascade .numbers caption {
    text-align: left; font-size: .76rem; text-transform: uppercase;
    letter-spacing: .05em; color: var(--accent); padding-bottom: .3rem;
  }
  .cascade .numbers th, .cascade .numbers td {
    border-bottom: 1px solid var(--rule); padding: .3rem .5rem; text-align: right;
  }
  .cascade .numbers th:first-child, .cascade .numbers td:first-child { text-align: left; }
  .cascade .numbers thead th { color: var(--muted); font-weight: normal; font-size: .74rem; }
  .cascade .numbers tfoot td { font-weight: bold; border-bottom: none; }
  .cascade .numbers .swatch {
    display: inline-block; width: .6rem; height: .6rem; border-radius: 2px;
    margin-right: .4rem; vertical-align: -1px;
  }
  .cascade .numbers .note {
    font-family: system-ui, sans-serif; font-size: .78rem; color: var(--muted); margin: 0 0 1rem;
  }
  .cascade .spark { display: flex; gap: 2px; align-items: flex-end; height: 2.1rem; margin-top: .3rem; }
  .cascade .spark i {
    flex: 1; background: var(--muted); opacity: .35; border-radius: 2px 2px 0 0;
    transition: height .3s ease;
  }
  .cascade .spark i.on { background: var(--accent); opacity: 1; }
  .cascade .spark-labels {
    display: flex; gap: 2px; font-size: .68rem; color: var(--muted); margin-top: .15rem;
  }
  .cascade .spark-labels span { flex: 1; text-align: center; }
</style>

<script>
  import { run, DEFAULTS, MIX_TODAY } from "../scripts/materialModel.js";
  import { COMPONENTS, MATERIALS, ORES, ORE_OF, LABELS, ORE, CAPACITY_FACTOR } from "../scripts/materialData.js";

  const NS = "http://www.w3.org/2000/svg";
  const svg = document.getElementById("flow");
  const $ = (s) => document.querySelector(s);

  // --- geometry -----------------------------------------------------------
  const W = 760, H = 440, TOP = 56, BOT = 402, NODE_W = 12, GAP_MIN = 7;
  const BAND = BOT - TOP;
  // Reversed from the shipped version: ore (raw material, the source) reads
  // left, capacity (the finished thing, the destination) reads right --
  // supply-chain / Sankey convention, and arguably a better fit for a page
  // titled "what a grid is MADE of" than the shipped decision-cascade order.
  // Array index order is untouched on purpose (tech=0, component=1,
  // material=2, ore=3) so every piece of index-keyed logic below (SIDE,
  // totals[2]/totals[3], headers[0..3], the ci===2||3 colour special-case)
  // stays correct without being touched -- only the FOUR X POSITIONS moved.
  const COLS = [
    { key: "tech", x: 600, nodes: ["gas", "solar", "wind", "battery", "grid"], title: "Capacity" },
    { key: "component", x: 410, nodes: COMPONENTS, title: "Component" },
    { key: "material", x: 220, nodes: MATERIALS, title: "Material" },
    { key: "ore", x: 36, nodes: ORES, title: "Ore moved" },
  ];
  const LAYERS = [
    { edge: "tech-component", from: 0, to: 1 },
    { edge: "component-material", from: 1, to: 2 },
    { edge: "material-ore", from: 2, to: 3 },
  ];
  const colorOf = (m) => `var(--m-${m})`;
  const nameOf = (k) => LABELS[k] ?? (k.charAt(0).toUpperCase() + k.slice(1));

  function el(name, attrs, text) {
    const n = document.createElementNS(NS, name);
    for (const k in attrs) n.setAttribute(k, attrs[k]);
    if (text != null) n.textContent = text;
    return n;
  }

  // Reused elements, keyed, so the browser can transition between states
  // instead of the diagram flickering out and back on every slider move.
  const keep = { ribbon: new Map(), node: new Map(), label: new Map(), orelab: new Map() };
  let chrome = null;

  /**
   * One decimal is enough at 600 Mt and not enough at 3 Mt: on a small total
   * the rows of the table below round so coarsely that they visibly fail to
   * add up to their own footer, which reads as an arithmetic error rather than
   * as rounding. Two decimals under ten units, one above.
   */
  const fmtT = (t) => {
    const [v, unit] = t >= 1e9 ? [t / 1e9, "Gt"] : t >= 1e6 ? [t / 1e6, "Mt"]
      : t >= 1e3 ? [t / 1e3, "kt"] : [t, "t"];
    if (unit === "t") return `${Math.round(v).toLocaleString()} t`;
    if (unit === "kt" && v >= 10) return `${Math.round(v).toLocaleString()} kt`;
    return `${v.toFixed(v < 10 ? 2 : 1)} ${unit}`;
  };
  const pct = (v) => `${Math.round(v * 100)}%`;

  // --- state --------------------------------------------------------------
  const SCENARIOS = {
    gas: { label: "Gas-heavy", gasShare: 70, swRatio: 0.5, storageHours: 1, lfpShare: 60, demandGrowth: 20,
      hint: "The fleet we know how to build. Least metal, and still the most copper-intensive rock per tonne of metal." },
    balanced: { label: "Balanced", gasShare: 30, swRatio: 0.5, storageHours: 3, lfpShare: 60, demandGrowth: 20,
      hint: "Gas roughly halves, wind and solar split the rest evenly." },
    solar: { label: "Solar + storage", gasShare: 15, swRatio: 0.7, storageHours: 6, lfpShare: 80, demandGrowth: 25,
      hint: "The lowest capacity factor in the set, so the most nameplate per terawatt-hour — and storage on top of it." },
    wind: { label: "Wind-heavy", gasShare: 15, swRatio: 0.25, storageHours: 3, lfpShare: 60, demandGrowth: 20,
      hint: "The most metal of any scenario here, and not the most rock. Wind is steel, and steel ore is rich." },
  };
  const state = { scenario: "balanced", period: 2, ...SCENARIOS.balanced };
  delete state.label; delete state.hint;

  function params() {
    const gas = state.gasShare / 100;
    const rest = 1 - gas;
    return {
      demandGrowth: state.demandGrowth / 1000,
      storageHours: state.storageHours,
      lfpShare: state.lfpShare / 100,
      mixTarget: { gas, solar: rest * state.swRatio, wind: rest * (1 - state.swRatio) },
    };
  }

  // --- layout -------------------------------------------------------------
  /**
   * Node totals per column, read off the edges so a node's height and the bands
   * touching it cannot disagree.
   *
   * Each column is measured on exactly ONE side. The middle two could be
   * measured on either — conservation makes inflow and outflow equal — but
   * adding both counts every tonne twice, and for the material column it adds
   * tonnes of metal to tonnes of ore, which is not even a quantity.
   */
  const SIDE = [
    { layer: "tech-component", end: "from" },
    { layer: "tech-component", end: "to" },
    { layer: "component-material", end: "to" },
    { layer: "material-ore", end: "to" },
  ];

  function totalsFor(period) {
    const t = COLS.map((c) => Object.fromEntries(c.nodes.map((n) => [n, 0])));
    for (const [i, { layer, end }] of SIDE.entries()) {
      for (const e of period.edges) {
        if (e.layer !== layer) continue;
        const node = e[end];
        if (node in t[i]) t[i][node] += e.value;
      }
    }
    return t;
  }

  function place(nodes, totals, scale) {
    const total = nodes.reduce((s, n) => s + totals[n], 0);
    const drawn = total * scale;
    const gap = nodes.length > 1 ? (BAND - drawn) / (nodes.length - 1) : 0;
    let y = TOP;
    const pos = {};
    for (const n of nodes) {
      const h = totals[n] * scale;
      pos[n] = { y0: y, y1: y + h, h };
      y += h + gap;
    }
    return pos;
  }

  /**
   * Columns 1–3 share one scale — conservation makes their totals identical,
   * so a band that looks the same width is the same tonnage. The ore column
   * cannot: it is roughly twenty times the tonnage and would run off the page.
   * It gets its own scale, and the header prints both totals so the break is
   * stated rather than hidden.
   */
  function layout(period) {
    const totals = totalsFor(period);
    const metal = Object.values(totals[2]).reduce((s, v) => s + v, 0);
    const rock = Object.values(totals[3]).reduce((s, v) => s + v, 0);
    const maxGaps = Math.max(...COLS.slice(0, 3).map((c) => c.nodes.length - 1));
    const sMetal = metal > 0 ? (BAND - maxGaps * GAP_MIN) / metal : 0;
    const sOre = rock > 0 ? (BAND - (COLS[3].nodes.length - 1) * GAP_MIN) / rock : 0;
    return {
      totals, metal, rock,
      scales: [sMetal, sMetal, sMetal, sOre],
      pos: COLS.map((c, i) => place(c.nodes, totals[i], i === 3 ? sOre : sMetal)),
    };
  }

  /**
   * Stack the bands leaving each source and arriving at each target. Both ends
   * are ordered by the node they connect to, which is what keeps the ribbons
   * from braiding: outgoing sorted by where they land, incoming by where they
   * came from, material as the tiebreak so a metal keeps its lane.
   */
  function ribbonGeometry(period, L) {
    const out = [];
    for (const [li, { edge, from, to }] of LAYERS.entries()) {
      const src = COLS[from], dst = COLS[to];
      const scale = L.scales[to];
      const edges = period.edges.filter((e) => e.layer === edge && e.value > 0);
      const oi = (n) => src.nodes.indexOf(n), ii = (n) => dst.nodes.indexOf(n);
      const mi = (m) => MATERIALS.indexOf(m);

      const offOut = {}, offIn = {};
      const bySrc = [...edges].sort((a, b) =>
        oi(a.from) - oi(b.from) || ii(a.to) - ii(b.to) || mi(a.material) - mi(b.material));
      const byDst = [...edges].sort((a, b) =>
        ii(a.to) - ii(b.to) || oi(a.from) - oi(b.from) || mi(a.material) - mi(b.material));

      // The source side of layer 3 is drawn at the material scale but the
      // target side at the ore scale, so each end is offset in its own units.
      const srcScale = L.scales[from];
      const startAt = {}, endAt = {};
      for (const e of bySrc) {
        const k = e.from;
        offOut[k] = offOut[k] ?? 0;
        startAt[`${e.from}|${e.to}|${e.material}`] = offOut[k];
        offOut[k] += (li === 2 ? e.value / ORE[e.to].tPerT : e.value) * srcScale;
      }
      for (const e of byDst) {
        const k = e.to;
        offIn[k] = offIn[k] ?? 0;
        endAt[`${e.from}|${e.to}|${e.material}`] = offIn[k];
        offIn[k] += e.value * scale;
      }

      for (const e of edges) {
        const k = `${e.from}|${e.to}|${e.material}`;
        const sp = L.pos[from][e.from], dp = L.pos[to][e.to];
        if (!sp || !dp) continue;
        const hs = (li === 2 ? e.value / ORE[e.to].tPerT : e.value) * srcScale;
        const hd = e.value * scale;
        out.push({
          key: `${edge}|${k}`,
          material: e.material,
          value: e.value,
          x1: src.x, x2: dst.x + NODE_W, // reversed: dst is now visually left of src
          y1a: sp.y0 + startAt[k], y1b: sp.y0 + startAt[k] + hs,
          y2a: dp.y0 + endAt[k], y2b: dp.y0 + endAt[k] + hd,
        });
      }
    }
    return out;
  }

  const pathFor = (r) => {
    const xm = (r.x1 + r.x2) / 2;
    return `M ${r.x1} ${r.y1a} C ${xm} ${r.y1a}, ${xm} ${r.y2a}, ${r.x2} ${r.y2a}`
         + ` L ${r.x2} ${r.y2b} C ${xm} ${r.y2b}, ${xm} ${r.y1b}, ${r.x1} ${r.y1b} Z`;
  };

  // --- draw ---------------------------------------------------------------
  function draw(period, L) {
    if (!chrome) {
      chrome = { headers: [], ribbons: el("g"), nodes: el("g"), labels: el("g") };
      svg.append(chrome.ribbons, chrome.nodes, chrome.labels);
      for (const c of COLS) {
        const t = el("text", {
          x: c.x, y: 26, "font-size": 11, fill: "var(--muted)",
          "font-family": "system-ui, sans-serif", "letter-spacing": ".06em",
        }, c.title.toUpperCase());
        const s = el("text", {
          x: c.x, y: 41, "font-size": 11, fill: "var(--text)",
          "font-family": "system-ui, sans-serif", "font-variant-numeric": "tabular-nums",
        });
        svg.append(t, s);
        chrome.headers.push(s);
      }
    }
    chrome.headers[0].textContent = "";
    chrome.headers[1].textContent = "";
    chrome.headers[2].textContent = fmtT(L.metal);
    chrome.headers[3].textContent = fmtT(L.rock);

    // ribbons
    const geo = ribbonGeometry(period, L);
    const seen = new Set();
    for (const r of geo) {
      seen.add(r.key);
      let p = keep.ribbon.get(r.key);
      if (!p) {
        p = el("path", { class: "ribbon", fill: colorOf(r.material), "fill-opacity": .42, d: pathFor(r) });
        p.append(el("title", {}, ""));
        chrome.ribbons.appendChild(p);
        keep.ribbon.set(r.key, p);
      }
      p.setAttribute("d", pathFor(r));
      p.setAttribute("fill", colorOf(r.material));
      p.style.opacity = "1";
      const [, from, to] = r.key.split("|");
      p.firstChild.textContent = `${nameOf(from)} → ${nameOf(to)}: ${fmtT(r.value)} of ${r.material}`;
    }
    for (const [k, p] of keep.ribbon) if (!seen.has(k)) p.style.opacity = "0";

    // The ore multiplier, printed on the link that applies it. Two jobs: it is
    // the actual mechanism of the last column, and it lets the ribbons be told
    // apart without relying on their colour.
    for (const r of geo) {
      if (!r.key.startsWith("material-ore|")) continue;
      const ore = r.key.split("|")[2];
      let t = keep.orelab.get(ore);
      if (!t) {
        t = el("text", {
          "font-size": 10.5, fill: "var(--text)", stroke: "var(--bg)", "stroke-width": 3,
          "paint-order": "stroke", "text-anchor": "middle",
          "font-family": "system-ui, sans-serif",
        });
        chrome.labels.appendChild(t);
        keep.orelab.set(ore, t);
      }
      t.textContent = `×${ORE[ore].tPerT}`;
      t.setAttribute("x", (r.x1 + r.x2) / 2);
      t.setAttribute("y", (r.y1a + r.y1b + r.y2a + r.y2b) / 4 + 4);
      t.style.opacity = r.y2b - r.y2a > 11 ? "1" : "0";
    }

    // nodes and labels
    for (const [ci, c] of COLS.entries()) {
      for (const n of c.nodes) {
        const pos = L.pos[ci][n];
        const nk = `${ci}|${n}`;
        let rect = keep.node.get(nk);
        if (!rect) {
          rect = el("rect", { class: "node", x: c.x, width: NODE_W, rx: 2, fill: "var(--text)", "fill-opacity": .5 });
          chrome.nodes.appendChild(rect);
          keep.node.set(nk, rect);
        }
        rect.setAttribute("y", pos.y0);
        rect.setAttribute("height", Math.max(0, pos.h));
        if (ci === 0 && n !== "grid") rect.setAttribute("fill", `var(--t-${n === "battery" ? "storage" : n})`);
        else if (ci === 2 || ci === 3) rect.setAttribute("fill", colorOf(ci === 2 ? n : ORE[n].material));

        let lab = keep.label.get(nk);
        if (!lab) {
          lab = el("text", {
            class: "nlabel", x: 0, y: 0, "font-size": 11.5,
            fill: "var(--text)", stroke: "var(--bg)", "stroke-width": 3.5,
            "paint-order": "stroke", "font-family": "system-ui, sans-serif",
          });
          chrome.labels.appendChild(lab);
          keep.label.set(nk, lab);
        }
        lab.textContent = nameOf(n);
        lab.setAttribute("transform", `translate(${c.x + NODE_W + 6}, ${(pos.y0 + pos.y1) / 2 + 4})`);
        lab.style.opacity = pos.h > 1.2 ? "1" : "0.28";
      }
    }
  }


  // --- the year: two bars in terawatt-hours ---------------------------------
  /**
   * Both rows are annual energy, so they can share one axis and one dashed
   * reference at true annual demand. An earlier pass put them on a gigawatt
   * axis as average load, which is a RATE -- it read as instantaneous and
   * quietly collapsed the distinction between this (the year) and the storage
   * view below (one day). Terawatt-hours keep the two tiers apart.
   *
   * Row one is the energy each technology actually delivers, so it ends
   * exactly on the dashed box. Row two is the same fleet run flat out for
   * 8760 hours, which is what nameplate would deliver if the resource were
   * always there. The ratio between them, per technology, is exactly
   * 1/capacity-factor.
   *
   * The region beyond the box is labelled for what it is: energy never
   * generated. It is NOT curtailment or charging loss -- those are real, and
   * together they run maybe five to fifteen percent of generation, not the
   * two hundred percent this gap represents. Calling a 3x bar "waste" would
   * overstate it by more than an order of magnitude, which is precisely the
   * move this page exists to argue against.
   */
  const multSvg = document.getElementById("mult");
  let multChrome = null;
  const GEN = ["gas", "solar", "wind"];
  const HOURS_PER_YEAR = 8760;

  const X0 = 104, X1 = 748, ROW_H = 20;
  const Y_ENERGY = 34, Y_CAPACITY = 66;
  const AXIS_W = X1 - X0;

  function drawMultiplier(period) {
    const rows = GEN.map((t) => ({
      tech: t,
      served: period.mix[t] * period.demandTWh,                     // TWh/yr delivered
      potential: (period.capacityGW[t] * HOURS_PER_YEAR) / 1000,    // TWh/yr at full output
    }));
    const totalPotential = rows.reduce((a, b) => a + b.potential, 0);

    const twhMax = Math.max(totalPotential, period.demandTWh) * 1.03;
    const sx = (twh) => X0 + (twh / twhMax) * AXIS_W;

    if (!multChrome) {
      multChrome = { bands: el("g"), bars: el("g"), boxes: el("g"), text: el("g"), keyed: new Map() };
      multSvg.append(multChrome.bands, multChrome.bars, multChrome.boxes, multChrome.text);

      for (const [label, y] of [["Energy served", Y_ENERGY], ["Run flat out", Y_CAPACITY]]) {
        multChrome.text.appendChild(el("text", {
          x: X0 - 10, y: y + 14, "text-anchor": "end", "font-size": 11,
          fill: "var(--muted)", "font-family": "system-ui, sans-serif",
        }, label));
      }

      multChrome.demandBox = el("rect", {
        fill: "none", stroke: "var(--text)", "stroke-width": 1.5,
        "stroke-dasharray": "5 3", rx: 2,
        y: Y_ENERGY - 7, height: (Y_CAPACITY + ROW_H) - (Y_ENERGY - 7) + 7,
      });
      multChrome.boxes.appendChild(multChrome.demandBox);

      multChrome.demandLabel = el("text", {
        "font-size": 10.5, fill: "var(--text)", "text-anchor": "middle",
        "font-family": "system-ui, sans-serif", "font-variant-numeric": "tabular-nums",
      });
      multChrome.gapLabel = el("text", {
        "font-size": 10, fill: "var(--muted)", "text-anchor": "middle",
        "font-family": "system-ui, sans-serif",
      });
      multChrome.text.append(multChrome.demandLabel, multChrome.gapLabel);
    }

    let e0 = X0, c0 = X0;
    for (const r of rows) {
      let g = multChrome.keyed.get(r.tech);
      if (!g) {
        g = {
          top: el("rect", { class: "bar", y: Y_ENERGY, height: ROW_H, fill: `var(--t-${r.tech})`, "fill-opacity": .85 }),
          bot: el("rect", { class: "bar", y: Y_CAPACITY, height: ROW_H, fill: `var(--t-${r.tech})`, "fill-opacity": .5 }),
          band: el("path", { class: "tie", fill: `var(--t-${r.tech})`, "fill-opacity": .18 }),
          lab: el("text", { "font-size": 10.5, fill: "var(--bg)", "text-anchor": "middle",
                            "font-family": "system-ui, sans-serif", "font-weight": "600" }),
        };
        multChrome.bands.appendChild(g.band);
        multChrome.bars.append(g.top, g.bot);
        multChrome.text.append(g.lab);
        multChrome.keyed.set(r.tech, g);
      }
      const ew = sx(r.served) - X0, cw = sx(r.potential) - X0;
      g.top.setAttribute("x", e0); g.top.setAttribute("width", Math.max(0, ew));
      g.bot.setAttribute("x", c0); g.bot.setAttribute("width", Math.max(0, cw));
      g.band.setAttribute("d",
        `M ${e0} ${Y_ENERGY + ROW_H} L ${e0 + ew} ${Y_ENERGY + ROW_H} `
        + `L ${c0 + cw} ${Y_CAPACITY} L ${c0} ${Y_CAPACITY} Z`);

      const stretch = r.served > 0 ? r.potential / r.served : 0;
      g.lab.textContent = cw > 70 ? `${nameOf(r.tech)} ×${stretch.toFixed(1)}` : "";
      g.lab.setAttribute("x", c0 + cw / 2);
      g.lab.setAttribute("y", Y_CAPACITY + 14);
      e0 += ew; c0 += cw;
    }

    const dx = sx(period.demandTWh);
    multChrome.demandBox.setAttribute("x", X0);
    multChrome.demandBox.setAttribute("width", Math.max(1, dx - X0));
    multChrome.demandLabel.textContent =
      `demand ${Math.round(period.demandTWh).toLocaleString()} TWh/yr`;
    multChrome.demandLabel.setAttribute("x", (X0 + dx) / 2);
    multChrome.demandLabel.setAttribute("y", Y_ENERGY - 13);

    // Name the gap honestly, in the gap.
    const gx = sx(totalPotential);
    multChrome.gapLabel.textContent = gx - dx > 190 ? "never generated — night, calm, idle plant" : "";
    multChrome.gapLabel.setAttribute("x", (dx + gx) / 2);
    multChrome.gapLabel.setAttribute("y", Y_ENERGY - 13);

    const overshoot = period.demandTWh > 0 ? totalPotential / period.demandTWh : 0;
    document.getElementById("mult-cap").textContent =
      `Over a year. The fleet delivers ${Math.round(period.demandTWh).toLocaleString()} TWh — the dashed `
      + `box — and the same fleet run flat out for all 8,760 hours would deliver `
      + `${Math.round(totalPotential).toLocaleString()} TWh, ${overshoot.toFixed(1)}× as much. The difference `
      + `is not waste and not curtailment: it is energy never generated, because the sun sets, the wind `
      + `drops and gas plants sit idle. Each technology's two bars differ by exactly 1/its capacity `
      + `factor — solar by ${(1 / CAPACITY_FACTOR.solar.value).toFixed(1)}×, gas by `
      + `${(1 / CAPACITY_FACTOR.gas.value).toFixed(1)}×. That ratio is what the materials below are bought against.`;

    document.getElementById("mult-desc").textContent =
      `Two horizontal bars in terawatt-hours per year. Energy served, split by technology, ending at a `
      + `dashed reference of ${Math.round(period.demandTWh).toLocaleString()} TWh of annual demand. Below it, `
      + `the same fleet run flat out: ${Math.round(totalPotential).toLocaleString()} TWh, `
      + `${overshoot.toFixed(1)} times the dashed box. ` + rows.map((r) =>
        `${nameOf(r.tech)} ${Math.round(r.served).toLocaleString()} TWh served against `
        + `${Math.round(r.potential).toLocaleString()} TWh flat out`).join("; ")
      + `. The gap is energy never generated, not energy wasted.`;
  }

  // --- one day: what share of it the battery carries ------------------------
  /**
   * Real model output, unlike the curve above it: one average day's demand is
   * annual demand over 365, and the battery's dispatched energy is its full
   * capacity, because the day being described is one where it fills from the
   * midday surplus and empties into the evening peak.
   *
   * Deliberately NOT expressed in hours of load, which an earlier pass did --
   * that is a power framing, and the question here is what share of a day's
   * ENERGY the battery covers. The box is the whole day; the fill is the part
   * the battery carries.
   */
  const daySvg = document.getElementById("storageday");
  let dayChrome = null;
  const DAY_Y = 22, DAY_H = 22;

  function drawStorageDay(period) {
    const dayGWh = (period.demandTWh * 1000) / 365;
    const held = period.storageGWh;

    // A battery cannot dispatch more energy into a day than the day consumes.
    // At the extreme settings it can be sized past that -- gas at zero puts it
    // near 120% of a day -- and letting the fill run past the box would draw a
    // claim that is not merely approximate but impossible. The fill is capped
    // at the day; the surplus is stated in words instead.
    const dispatched = Math.min(held, dayGWh);
    const exceedsDay = held > dayGWh;
    const scaleMax = dayGWh * 1.02;
    const sxd = (gwh) => X0 + (Math.min(gwh, dayGWh) / scaleMax) * AXIS_W;

    if (!dayChrome) {
      dayChrome = {};
      dayChrome.box = el("rect", {
        fill: "none", stroke: "var(--text)", "stroke-width": 1.5,
        "stroke-dasharray": "5 3", rx: 2, y: DAY_Y - 5, height: DAY_H + 10,
      });
      dayChrome.bar = el("rect", {
        class: "bar", y: DAY_Y, height: DAY_H, rx: 1,
        fill: "var(--t-storage)", "fill-opacity": .85,
      });
      dayChrome.rowLabel = el("text", {
        x: X0 - 10, y: DAY_Y + 15, "text-anchor": "end", "font-size": 11,
        fill: "var(--muted)", "font-family": "system-ui, sans-serif",
      }, "One day");
      dayChrome.boxLabel = el("text", {
        "font-size": 10.5, fill: "var(--text)", "text-anchor": "middle",
        "font-family": "system-ui, sans-serif", "font-variant-numeric": "tabular-nums",
      });
      dayChrome.barLabel = el("text", {
        "font-size": 10.5, "text-anchor": "start", "font-family": "system-ui, sans-serif",
        fill: "var(--text)", stroke: "var(--bg)", "stroke-width": 3, "paint-order": "stroke",
        "font-variant-numeric": "tabular-nums",
      });
      daySvg.append(dayChrome.bar, dayChrome.box, dayChrome.rowLabel,
                    dayChrome.boxLabel, dayChrome.barLabel);
    }

    const boxEnd = sxd(dayGWh), barEnd = sxd(dispatched);
    dayChrome.box.setAttribute("x", X0);
    dayChrome.box.setAttribute("width", Math.max(1, boxEnd - X0));
    dayChrome.bar.setAttribute("x", X0);
    dayChrome.bar.setAttribute("width", Math.max(0, barEnd - X0));

    dayChrome.boxLabel.textContent =
      `one day's demand ${Math.round(dayGWh).toLocaleString()} GWh`;
    dayChrome.boxLabel.setAttribute("x", (X0 + boxEnd) / 2);
    dayChrome.boxLabel.setAttribute("y", DAY_Y - 11);

    const share = dayGWh > 0 ? dispatched / dayGWh : 0;
    dayChrome.barLabel.textContent = exceedsDay
      ? `battery holds ${Math.round(held).toLocaleString()} GWh — more than this whole day`
      : `battery dispatches ${Math.round(dispatched).toLocaleString()} GWh — `
        + `${Math.round(share * 100)}% of the day`;
    dayChrome.barLabel.setAttribute("x", Math.min(barEnd + 8, X1 - 250));
    dayChrome.barLabel.setAttribute("y", DAY_Y + 15);

    document.getElementById("day-cap").textContent = exceedsDay
      ? `Over one day. An average day takes ${Math.round(dayGWh).toLocaleString()} GWh — the dashed box, and `
        + `the area under a day's load curve. At this setting the fleet holds `
        + `${Math.round(held).toLocaleString()} GWh, more than the whole day, so the bar fills the box and `
        + `the rest would carry into the next one. The curve is illustrative; these numbers are not.`
      : `Over one day. An average day takes ${Math.round(dayGWh).toLocaleString()} GWh — the dashed box, and `
        + `the area under a day's load curve. A battery holding `
        + `${Math.round(dispatched).toLocaleString()} GWh, charged once from the midday surplus and emptied `
        + `into the evening peak, carries ${Math.round(share * 100)}% of it. The curve is illustrative; these `
        + `two numbers are not.`;

    const d = document.getElementById("day-desc");
    if (d) d.textContent = exceedsDay
      ? `A horizontal bar. The dashed box is one average day's demand, `
        + `${Math.round(dayGWh).toLocaleString()} gigawatt-hours. The battery holds `
        + `${Math.round(held).toLocaleString()} gigawatt-hours, more than the whole day, so the bar fills `
        + `the box completely.`
      : `A horizontal bar. The dashed box is one average day's demand, `
        + `${Math.round(dayGWh).toLocaleString()} gigawatt-hours. The filled portion is the energy the `
        + `battery dispatches in that day, ${Math.round(dispatched).toLocaleString()} gigawatt-hours, or `
        + `${Math.round(share * 100)} percent of the day's demand.`;
  }


  // --- why storage exists, as a diagram rather than a chart -----------------
  /**
   * SCHEMATIC. Every shape below comes from a formula chosen to look like a
   * plausible day. None of it is model output: the model has no time
   * resolution at all, just one annual figure per technology.
   *
   * It is here because storage's job is invisible on any annual axis -- over a
   * year it serves zero net energy -- so the only way to show what it does is
   * to show a shape the model cannot compute. Drawn deliberately without a
   * value axis, labelled illustrative, and NOT wired to the controls, because
   * a diagram that responded to the sliders would be claiming to have
   * calculated something it has not.
   */
  function drawSchematic() {
    const svg = document.getElementById("schematic");
    if (!svg || svg.dataset.drawn) return;
    svg.dataset.drawn = "1";

    const L = 56, R = 730, T = 22, B = 104, W = R - L, H = B - T;
    const x = (h) => L + (h / 24) * W;
    const y = (v) => B - v * H;                    // v is unitless, 0..1.35

    // Illustrative shapes: a load curve with a morning ramp and an evening
    // peak, and a solar bell that overshoots it in the middle of the day.
    const demand = (h) =>
      0.52 + 0.20 * Math.exp(-((h - 9) ** 2) / 12) + 0.34 * Math.exp(-((h - 19) ** 2) / 8);
    const solar = (h) => (h > 6 && h < 18 ? 1.18 * Math.sin((Math.PI * (h - 6)) / 12) ** 1.4 : 0);

    const pts = [];
    for (let h = 0; h <= 24; h += 0.25) pts.push(h);
    const path = (f) => pts.map((h, i) => `${i ? "L" : "M"} ${x(h).toFixed(1)} ${y(f(h)).toFixed(1)}`).join(" ");

    const surplus = pts.filter((h) => solar(h) > demand(h));
    if (surplus.length) {
      const up = surplus.map((h) => `L ${x(h).toFixed(1)} ${y(solar(h)).toFixed(1)}`).join(" ");
      const down = [...surplus].reverse().map((h) => `L ${x(h).toFixed(1)} ${y(demand(h)).toFixed(1)}`).join(" ");
      svg.appendChild(el("path", {
        d: `M ${x(surplus[0]).toFixed(1)} ${y(demand(surplus[0])).toFixed(1)} ${up} ${down} Z`,
        fill: "var(--t-storage)", "fill-opacity": .34,
      }));
    }
    // Only the PEAK, not the whole evening. Shading from the demand curve down
    // to the baseline would say the battery carries every evening watt, which
    // is a much larger claim than anyone makes for it -- gas and wind are
    // still running. The band sits above the level demand runs at the rest of
    // the day, so it reads as the peak the battery shaves.
    const BASE = 0.62;
    const evening = pts.filter((h) => h >= 16.5 && h <= 23 && demand(h) > BASE);
    if (evening.length > 1) {
      const over = evening.map((h) => `L ${x(h).toFixed(1)} ${y(demand(h)).toFixed(1)}`).join(" ");
      svg.appendChild(el("path", {
        d: `M ${x(evening[0]).toFixed(1)} ${y(BASE).toFixed(1)} ${over} `
           + `L ${x(evening[evening.length - 1]).toFixed(1)} ${y(BASE).toFixed(1)} Z`,
        fill: "var(--t-storage)", "fill-opacity": .28,
      }));
    }

    svg.appendChild(el("path", { d: path(solar), fill: "none", stroke: "var(--t-solar)", "stroke-width": 2 }));
    svg.appendChild(el("path", {
      d: path(demand), fill: "none", stroke: "var(--text)", "stroke-width": 1.8, "stroke-dasharray": "5 3",
    }));

    svg.appendChild(el("line", { x1: L, x2: R, y1: B, y2: B, stroke: "var(--rule)", "stroke-width": 1 }));
    for (const [h, t] of [[0, "midnight"], [12, "noon"], [24, "midnight"]]) {
      svg.appendChild(el("text", {
        x: x(h), y: B + 14, "text-anchor": "middle", "font-size": 10,
        fill: "var(--muted)", "font-family": "system-ui, sans-serif",
      }, t));
    }

    const note = (tx, ty, text, fill, anchor) => svg.appendChild(el("text", {
      x: tx, y: ty, "text-anchor": anchor || "middle", "font-size": 10.5, fill,
      "font-family": "system-ui, sans-serif", stroke: "var(--bg)", "stroke-width": 3,
      "paint-order": "stroke",
    }, text));
    // Value 1.0 maps to the top of the drawing area, so anything above it is
    // outside the viewBox: the surplus label sat at 1.30 and was clipped
    // entirely. It belongs inside the wedge it names anyway.
    note(x(12), y(0.90), "surplus charges the battery", "var(--text)");
    note(x(19.1), y(0.70), "battery shaves the evening peak", "var(--text)");
    note(x(2.6), y(0.60), "demand", "var(--text)", "start");
    note(x(7.8), y(0.46), "solar", "var(--t-solar)", "start");
  }

  // --- legend and readout -------------------------------------------------
  function legend(L) {
    const box = document.getElementById("legend");
    box.innerHTML = "";

    const techLabel = document.createElement("span");
    techLabel.className = "legend-group";
    techLabel.textContent = "Technology:";
    box.appendChild(techLabel);
    for (const t of [...GEN, "battery"]) {
      const s = document.createElement("span");
      const varName = t === "battery" ? "storage" : t;
      s.innerHTML = `<i class="sw" style="background:var(--t-${varName})"></i>${nameOf(t)}`;
      box.appendChild(s);
    }

    const matLabel = document.createElement("span");
    matLabel.className = "legend-group";
    matLabel.textContent = "Material:";
    box.appendChild(matLabel);
    for (const m of MATERIALS) {
      const s = document.createElement("span");
      s.innerHTML = `<i class="sw" style="background:${colorOf(m)}"></i>${nameOf(m)}`;
      box.appendChild(s);
    }

    const note = document.createElement("span");
    note.className = "scale-note";
    const ratio = L.metal > 0 ? L.rock / L.metal : 0;
    note.textContent =
      `Ribbon width is tonnage, on one scale for the rightmost three columns. The ore column, on `
      + `the left, is ${ratio.toFixed(0)}× the tonnage of the material column and is drawn to the `
      + `same height so it fits — compare within a column, not across that gap.`;
    box.appendChild(note);
  }

  /**
   * The numbers as text.
   *
   * This is not a debugging aid bolted on afterwards. A figure that carries
   * the whole argument has to be readable by someone who is not reading it
   * with their eyes, and on a phone it is the only readable form there is --
   * the diagram's type lands at about five pixels at 375px wide. So the table
   * is the diagram's equal, not its fallback, and it is built from the same
   * period object rather than from a second pass over the model.
   */
  function buildTables(r, period) {
    const box = document.getElementById("tables");
    const rows = MATERIALS
      .map((m) => ({
        m, ore: ORE_OF[m],
        t: period.byMaterial[m],
        rock: period.byOre[ORE_OF[m]],
        mult: ORE[ORE_OF[m]].tPerT,
      }))
      .filter((x) => x.t > 0)
      .sort((a, b) => b.rock - a.rock);

    // Rounding a real quantity to "0%" reads as absent rather than small, and
    // lithium is genuinely tiny by mass and the reason the page exists.
    const sh = (v, tot) => {
      if (tot <= 0) return "—";
      const f = v / tot;
      return f > 0 && f < 0.005 ? "<1%" : pct(f);
    };
    const matRows = rows.map((x) => `<tr>
      <td><i class="swatch" style="background:${colorOf(x.m)}"></i>${nameOf(x.m)}</td>
      <td>${fmtT(x.t)}</td><td>${sh(x.t, period.totalMetal)}</td>
      <td>${nameOf(x.ore)}</td><td>×${x.mult}</td>
      <td>${fmtT(x.rock)}</td><td>${sh(x.rock, period.totalOre)}</td></tr>`).join("");

    const capRows = ["gas", "solar", "wind"].map((t) => `<tr>
      <td>${nameOf(t)}</td><td>${pct(period.mix[t])}</td>
      <td>${pct(CAPACITY_FACTOR[t].value)}</td>
      <td>${Math.round(period.capacityGW[t]).toLocaleString()} GW</td>
      <td>${Math.round(period.builtGW[t]).toLocaleString()} GW</td></tr>`).join("");

    box.innerHTML = `
      <p class="note">${period.isExisting
        ? "The fleet already standing, priced as if it were bought now."
        : `Built between the previous period and ${period.label}.`}
        Serving ${Math.round(period.demandTWh).toLocaleString()} TWh a year.</p>

      <div class="tw"><table>
        <caption>Metal, and the rock it came out of</caption>
        <thead><tr><th>Material</th><th>Tonnes</th><th>Share of metal</th>
          <th>Ore</th><th>Rock per tonne</th><th>Rock</th><th>Share of rock</th></tr></thead>
        <tbody>${matRows}</tbody>
        <tfoot><tr><td>Total</td><td>${fmtT(period.totalMetal)}</td><td>100%</td>
          <td></td><td></td><td>${fmtT(period.totalOre)}</td><td>100%</td></tr></tfoot>
      </table></div>

      <div class="tw"><table>
        <caption>Capacity — multiplier one</caption>
        <thead><tr><th>Technology</th><th>Share of energy</th><th>Capacity factor</th>
          <th>Standing</th><th>Built this period</th></tr></thead>
        <tbody>${capRows}</tbody>
      </table></div>`;
  }

  /** One sentence saying what the diagram SHOWS, regenerated on every change. */
  function describeFlow(period) {
    const top = MATERIALS.reduce((a, b) =>
      period.byMaterial[b] > period.byMaterial[a] ? b : a);
    const topOre = ORES.reduce((a, b) => (period.byOre[b] > period.byOre[a] ? b : a));
    const cuM = period.totalMetal > 0 ? period.byMaterial.copper / period.totalMetal : 0;
    const cuR = period.totalOre > 0 ? period.byOre["copper ore"] / period.totalOre : 0;
    document.getElementById("flow-desc").textContent =
      `${period.label}: building this capacity takes ${fmtT(period.totalMetal)} of metal and moves `
      + `${fmtT(period.totalOre)} of rock. The largest share of the metal is ${nameOf(top).toLowerCase()}, `
      + `but the largest share of the rock is ${nameOf(topOre).toLowerCase()} — the ranking changes `
      + `between the two columns. Copper is ${pct(cuM)} of the metal and ${pct(cuR)} of the rock. `
      + `Full figures in the table below.`;
  }

  function readout(r, period) {
    // Per-period, not per-build-ahead. The card used to quote the whole
    // horizon while every cell beside it quoted one period, so on "Today" the
    // big number and the small ones were describing different decades.
    const cuM = period.totalMetal > 0 ? period.byMaterial.copper / period.totalMetal : 0;
    const cuR = period.totalOre > 0 ? period.byOre["copper ore"] / period.totalOre : 0;

    const dl = document.getElementById("readout");
    dl.innerHTML = "";

    const head = document.createElement("div");
    head.className = "wide";
    head.innerHTML =
      `<dt>Copper, ${period.isExisting ? "in the fleet already standing" : period.label}</dt>`
      + `<dd>${pct(cuM)} of the metal, ${pct(cuR)} of the rock `
      + `<small>— steel dominates the tonnage; copper dominates the mining</small></dd>`;
    dl.appendChild(head);

    for (const [k, v] of [
      ["Serving", `${Math.round(period.demandTWh).toLocaleString()} <small>TWh/yr</small>`],
      ["Capacity standing", `${Math.round(Object.values(period.capacityGW).reduce((a, b) => a + b, 0)).toLocaleString()} <small>GW</small>`],
      ["Metal", fmtT(period.totalMetal)],
      ["Rock moved", fmtT(period.totalOre)],
      ["Lithium", fmtT(period.byMaterial.lithium)],
    ]) {
      const d = document.createElement("div");
      d.innerHTML = `<dt>${k}</dt><dd>${v}</dd>`;
      dl.appendChild(d);
    }

    // Three periods at once, so the horizon is visible without clicking
    // through it. Read-only -- the segmented control above is still the way
    // to change period, rather than two controls doing one job.
    const peak = Math.max(...r.periods.map((x) => x.totalOre), 1);
    const spark = document.createElement("div");
    spark.innerHTML = `<dt>Rock moved, by period</dt>
      <dd class="spark">${r.periods.map((x, i) =>
        `<i class="${i === state.period ? "on" : ""}" style="height:${Math.max(3, (x.totalOre / peak) * 100)}%"
            title="${x.label}: ${fmtT(x.totalOre)}"></i>`).join("")}</dd>
      <div class="spark-labels">${r.periods.map((x) => `<span>${x.label}</span>`).join("")}</div>`;
    dl.appendChild(spark);
  }

  // --- wiring -------------------------------------------------------------
  function syncLabels() {
    const o = (id, text) => { const e = document.querySelector(`output[data-for=${id}]`); if (e) e.textContent = text; };
    o("demandGrowth", `${(state.demandGrowth / 10).toFixed(1)}%/yr`);
    o("gasShare", `${state.gasShare}%`);
    o("storageHours", state.storageHours === 0 ? "none" : `${state.storageHours} GWh/GW`);
    o("lfpShare", `${state.lfpShare}%`);

    const p = params().mixTarget;
    $("#mix-hint").textContent =
      `Gas ${pct(p.gas)} · solar ${pct(p.solar)} · wind ${pct(p.wind)}. `
      + `Capacity factors ${pct(CAPACITY_FACTOR.gas.value)} / ${pct(CAPACITY_FACTOR.solar.value)} / `
      + `${pct(CAPACITY_FACTOR.wind.value)} — that spread is the first multiplier.`;

    const s = SCENARIOS[state.scenario];
    $("#scen-hint").textContent = s ? s.hint : "Custom mix — the scenario buttons will set it back.";
    $("#period-hint").textContent = state.period === 0
      ? "The fleet already standing, priced as if it were built now. A reference point, not a purchase."
      : "Materials for what gets built in this period — the increase in capacity, not the capacity itself.";
  }

  function update() {
    const r = run(params());
    const period = r.periods[state.period];
    const L = layout(period);
    drawMultiplier(period);
    drawStorageDay(period);
    draw(period, L);
    describeFlow(period);
    legend(L);
    readout(r, period);
    buildTables(r, period);
    syncLabels();
    writeShareState();
  }

  // --- shareable state ------------------------------------------------------
  /**
   * The page argues "take gas to ninety percent and watch the copper refuse to
   * leave" -- an instruction the reader has to carry out by hand. With the
   * controls in the query string that becomes a link, which is the difference
   * between a demo and something an instructor can assign or a talk can cite.
   *
   * Only values that differ from the default are written, so a scenario button
   * gives a short readable URL (?s=solar) and an untouched page gives none at
   * all. Everything read back is clamped against the control that owns it --
   * a query string is user input and arrives from anywhere.
   */
  const SHARE_KEYS = { g: "gasShare", sw: "swRatio", st: "storageHours",
                       lfp: "lfpShare", dg: "demandGrowth" };
  const BASE_STATE = (() => {
    const b = { scenario: "balanced", period: 2, ...SCENARIOS.balanced };
    delete b.label; delete b.hint;
    return b;
  })();

  const clampToControl = (id, v) => {
    const inp = document.getElementById(id);
    if (!inp) return v;
    const lo = Number(inp.min), hi = Number(inp.max);
    return Math.min(hi, Math.max(lo, v));
  };

  function readShareState() {
    const q = new URLSearchParams(location.search);
    if (![...q.keys()].some((k) => k === "s" || k === "p" || k in SHARE_KEYS)) return false;

    const scen = q.get("s");
    if (scen && SCENARIOS[scen]) {
      Object.assign(state, SCENARIOS[scen], { scenario: scen });
      delete state.label; delete state.hint;
    }
    let custom = false;
    for (const [key, prop] of Object.entries(SHARE_KEYS)) {
      if (!q.has(key)) continue;
      const raw = Number(q.get(key));
      if (!Number.isFinite(raw)) continue;
      state[prop] = prop === "swRatio"
        ? Math.min(1, Math.max(0, raw / 100))
        : clampToControl(prop, raw);
      custom = true;
    }
    if (custom) state.scenario = null;

    const per = Number(q.get("p"));
    if (Number.isInteger(per) && per >= 0 && per <= 2) state.period = per;
    return true;
  }

  /** Push the controls' values back into the DOM after a URL-driven load. */
  function syncControlsToState() {
    for (const id of ["demandGrowth", "gasShare", "storageHours", "lfpShare"]) {
      const inp = document.getElementById(id);
      if (inp) inp.value = state[id];
    }
    document.querySelectorAll("#scen button").forEach((b) =>
      b.classList.toggle("on", b.dataset.v === state.scenario));
    document.querySelectorAll("#period button").forEach((b) =>
      b.classList.toggle("on", Number(b.dataset.v) === state.period));
  }

  let shareTimer = null;
  function writeShareState() {
    // replaceState rather than pushState: a slider drag must not fill the back
    // button with a hundred entries. Debounced because Safari throttles it.
    clearTimeout(shareTimer);
    shareTimer = setTimeout(() => {
      const q = new URLSearchParams();
      const named = state.scenario && SCENARIOS[state.scenario];
      if (named) {
        if (state.scenario !== BASE_STATE.scenario) q.set("s", state.scenario);
      } else {
        for (const [key, prop] of Object.entries(SHARE_KEYS)) {
          const v = prop === "swRatio" ? Math.round(state[prop] * 100) : state[prop];
          const base = prop === "swRatio" ? Math.round(BASE_STATE[prop] * 100) : BASE_STATE[prop];
          if (v !== base) q.set(key, String(v));
        }
      }
      if (state.period !== BASE_STATE.period) q.set("p", String(state.period));
      const qs = q.toString();
      history.replaceState(null, "", qs ? `${location.pathname}?${qs}` : location.pathname);
    }, 150);
  }

  function applyScenario(key) {
    Object.assign(state, SCENARIOS[key], { scenario: key });
    delete state.label; delete state.hint;
    for (const id of ["demandGrowth", "gasShare", "storageHours", "lfpShare"]) {
      const inp = document.getElementById(id);
      if (inp) inp.value = state[id];
    }
    document.querySelectorAll("#scen button").forEach((b) => b.classList.toggle("on", b.dataset.v === key));
    update();
  }

  document.querySelectorAll(".controls input[type=range]").forEach((inp) => {
    inp.addEventListener("input", () => {
      state[inp.id] = Number(inp.value);
      state.scenario = null;
      document.querySelectorAll("#scen button").forEach((b) => b.classList.remove("on"));
      update();
    });
  });

  document.querySelectorAll("#scen button").forEach((b) =>
    b.addEventListener("click", () => applyScenario(b.dataset.v)));

  document.querySelectorAll("#period button").forEach((b) =>
    b.addEventListener("click", () => {
      document.querySelectorAll("#period button").forEach((o) => o.classList.remove("on"));
      b.classList.add("on");
      state.period = Number(b.dataset.v);
      update();
    }));

  $("#share").addEventListener("click", async (e) => {
    const btn = e.currentTarget;
    const said = btn.textContent;
    try {
      await navigator.clipboard.writeText(location.href);
      btn.textContent = "Copied";
    } catch {
      // Clipboard access can be refused outright (insecure context, denied
      // permission). Selecting the URL is a worse fallback than saying so.
      btn.textContent = "Copy failed";
    }
    setTimeout(() => { btn.textContent = said; }, 1600);
  });

  $("#reset").addEventListener("click", () => {
    state.period = 2;
    document.querySelectorAll("#period button").forEach((o) => o.classList.toggle("on", o.dataset.v === "2"));
    applyScenario("balanced");
  });

  // On a phone the table is the only readable view, so it is not left behind a
  // disclosure the reader has to think to open.
  const narrow = window.matchMedia("(max-width: 600px)");
  const syncDisclosure = () => { document.getElementById("numbers").open = narrow.matches; };
  narrow.addEventListener("change", syncDisclosure);
  syncDisclosure();

  if (readShareState()) syncControlsToState();

  update();
  drawSchematic();

  // Let a host page size the iframe to the content instead of guessing.
  const post = () => parent.postMessage({ type: "cascade-height", height: document.body.scrollHeight }, "*");
  if (window.parent !== window) {
    post();
    new ResizeObserver(post).observe(document.body);
  }
</script>
