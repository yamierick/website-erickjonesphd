---
/**
 * Shadow prices and KKT, live. Sliders change the labor and wood available; the
 * feasible region, the optimal corner and z move, and a second chart plots z
 * against labor hours so the shadow price shows up as a slope. Two more sliders let
 * the reader try their own prices y and watch which of the four KKT lines fail.
 * Engine: lp2, shadow and kkt in src/scripts/teach/or.js (tested in or.test.mjs).
 */
---
<div class="sx" data-shadow>
  <p class="sx-head"><strong>Try it.</strong> Change the resources and watch the best corner, the profit and the prices move. Then try your own prices in the KKT check.</p>
  <div class="sx-sliders">
    <label>Labor hours <output data-o="b1"></output><input type="range" min="10" max="100" step="1" data-k="b1" value="40" /></label>
    <label>Wood units <output data-o="b2"></output><input type="range" min="40" max="200" step="5" data-k="b2" value="120" /></label>
  </div>
  <div class="sx-grid">
    <div class="fig sx-graph" data-graph></div>
    <div class="sx-side">
      <div data-read></div>
      <div class="fig sx-graph" data-slope></div>
    </div>
  </div>
  <h4 class="sx-sub">Check KKT with any prices</h4>
  <div class="sx-sliders">
    <label>Labor price y₁ <output data-o="y1"></output><input type="range" min="0" max="50" step="0.5" data-k="y1" value="16" /></label>
    <label>Wood price y₂ <output data-o="y2"></output><input type="range" min="0" max="20" step="0.5" data-k="y2" value="6" /></label>
    <button type="button" class="sx-small" data-act="opt">Use the shadow prices</button>
  </div>
  <div class="scroll" data-kkt></div>
</div>

<script>
  import { lp2, shadow, kkt } from "../../scripts/teach/or.js";
  import { plot } from "../../lib/fig.js";
  import { bind, fmt, money } from "../../scripts/teach/ui.js";

  const c = [40, 50];
  const A = (b1, b2) => [[1, 2], [4, 3]];

  /** Vertices of { A x ≤ b, x ≥ 0 } in order around the region. */
  function polygon(Am, b) {
    const L = [...Am.map((a, i) => [a[0], a[1], b[i]]), [-1, 0, 0], [0, -1, 0]];
    const pts = [];
    for (let i = 0; i < L.length; i++) for (let j = i + 1; j < L.length; j++) {
      const [a1, b1, c1] = L[i], [a2, b2, c2] = L[j], det = a1 * b2 - a2 * b1;
      if (Math.abs(det) < 1e-12) continue;
      const p = [(c1 * b2 - c2 * b1) / det, (a1 * c2 - a2 * c1) / det];
      if (L.every(([p1, q1, r1]) => p1 * p[0] + q1 * p[1] <= r1 + 1e-7) && !pts.some((q) => Math.hypot(q[0] - p[0], q[1] - p[1]) < 1e-7)) pts.push(p);
    }
    const cx = pts.reduce((s, p) => s + p[0], 0) / pts.length, cy = pts.reduce((s, p) => s + p[1], 0) / pts.length;
    return pts.sort((p, q) => Math.atan2(p[1] - cy, p[0] - cx) - Math.atan2(q[1] - cy, q[0] - cx));
  }

  for (const root of document.querySelectorAll("[data-shadow]")) {
    const st = { b1: 40, b2: 120, y1: 16, y2: 6 };
    let set, lastB = "40,120";
    const draw = () => {
      const b = [st.b1, st.b2], Am = A(), r = lp2(c, Am, b), y = shadow(c, Am, r.x, r.tight);
      // When the resources change, the price sliders follow the new shadow prices.
      if (set && `${st.b1},${st.b2}` !== lastB) { set("y1", y[0]); set("y2", y[1]); }
      lastB = `${st.b1},${st.b2}`;
      const M = 50;
      const g = plot({ w: 420, h: 380, x: [0, M], y: [0, M], pad: [16, 12, 40, 44] })
        .axes({ xt: [0, 10, 20, 30, 40, 50], yt: [0, 10, 20, 30, 40, 50], xl: "x₁ chairs", yl: "x₂ tables", grid: true })
        .area(polygon(Am, b))
        .line([[0, b[0] / 2], [b[0], 0]].map(([x, yy]) => [Math.min(x, M), yy]), "ln")
        .line([[0, b[1] / 3], [b[1] / 4, 0]], "ln");
      const z = r.z, hits = [[0, z / c[1]], [z / c[0], 0]];
      g.line(hits.map(([x, yy]) => (yy > M ? [(z - c[1] * M) / c[0], M] : [x, yy])), "dash-a")
        .dot(r.x[0], r.x[1], "pt", 7)
        .text(r.x[0], r.x[1], `(${fmt(r.x[0])}, ${fmt(r.x[1])})`, { dx: 9, dy: -8, cls: "strong" });
      root.querySelector("[data-graph]").innerHTML = g.svg(`Feasible region with labor ${b[0]} and wood ${b[1]}. The best corner is (${fmt(r.x[0])}, ${fmt(r.x[1])}), profit ${fmt(z)}.`);

      // z against labor hours, holding wood fixed: a piecewise line whose slope is y1.
      const zs = Array.from({ length: 101 }, (_, h) => [h, h === 0 ? 0 : lp2(c, Am, [h, st.b2]).z]);
      const zmax = Math.max(...zs.map((p) => p[1]));
      const sp = plot({ w: 360, h: 200, x: [0, 100], y: [0, Math.ceil(zmax / 500) * 500], pad: [14, 12, 36, 52] })
        .axes({ xt: [0, 20, 40, 60, 80, 100], yt: [0, Math.ceil(zmax / 500) * 250, Math.ceil(zmax / 500) * 500], xl: "labor hours", yl: "best z", xfmt: String, yfmt: (v) => fmt(v, 0) })
        .line(zs, "ln-a").dot(st.b1, z, "pt", 5)
        .text(st.b1, z, `slope ${fmt(y[0])}`, { dx: 8, dy: 16, cls: "strong" });
      root.querySelector("[data-slope]").innerHTML = sp.svg(`Best profit against labor hours. Its slope at ${st.b1} hours is the labor shadow price, ${fmt(y[0])}.`);

      const slack = b.map((bi, i) => bi - (Am[i][0] * r.x[0] + Am[i][1] * r.x[1]));
      root.querySelector("[data-read]").innerHTML = `
        <p class="sx-say"><strong>Best plan:</strong> ${fmt(r.x[0])} chairs and ${fmt(r.x[1])} tables, <strong>z = ${money(z, 0)}</strong>.<br>
        <strong>Shadow prices:</strong> labor <strong>${money(y[0])}</strong> an hour, wood <strong>${money(y[1])}</strong> a unit.<br>
        ${slack.map((s, i) => (s > 1e-7 ? `${["Labor", "Wood"][i]} has ${fmt(s)} left over, so its price is $0.` : "")).join(" ")}
        One more hour of labor is worth ${money(y[0])}: the slope of the chart below.</p>`;
      paintKKT(r.x, y);
    };
    const paintKKT = (x, yOpt) => {
      const b = [st.b1, st.b2], y = [st.y1, st.y2], k = kkt(c, A(), b, x, y);
      const mark = (ok) => `<span class="${ok ? "hx-yes" : "hx-no"}">${ok ? "✓" : "✗"}</span>`;
      const cs1ok = Math.abs(k.cs1) < 1e-6, cs2ok = Math.abs(k.cs2) < 1e-6;
      root.querySelector("[data-kkt]").innerHTML = `<table class="num left sx-kkt">
        <thead><tr><th>Line</th><th>With x = (${fmt(x[0])}, ${fmt(x[1])}) and y = (${fmt(y[0])}, ${fmt(y[1])})</th><th></th></tr></thead><tbody>
        <tr><td>Ax ≤ b</td><td>labor ${fmt(k.Ax[0])} ≤ ${fmt(b[0])}, wood ${fmt(k.Ax[1])} ≤ ${fmt(b[1])}</td><td>${mark(k.primal)}</td></tr>
        <tr><td>Aᵀy ≥ c</td><td>chair ${fmt(k.ATy[0])} ≥ 40, table ${fmt(k.ATy[1])} ≥ 50</td><td>${mark(k.dual)}</td></tr>
        <tr><td>y(b − Ax) = 0</td><td>${fmt(y[0])}(${fmt(b[0] - k.Ax[0])}) + ${fmt(y[1])}(${fmt(b[1] - k.Ax[1])}) = ${fmt(k.cs1)}</td><td>${mark(cs1ok)}</td></tr>
        <tr><td>x(c − Aᵀy) = 0</td><td>${fmt(x[0])}(${fmt(40 - k.ATy[0])}) + ${fmt(x[1])}(${fmt(50 - k.ATy[1])}) = ${fmt(k.cs2)}</td><td>${mark(cs2ok)}</td></tr>
        </tbody></table>
        <p class="sx-say">${k.primal && k.dual && cs1ok && cs2ok ? "<strong>All four hold: x and y are both optimal.</strong>" :
          !k.dual ? "These prices fail dual feasibility: some product looks underpriced, so the prices can't be right." :
          "Feasible prices, but complementary slackness fails: the prices and the plan contradict each other, so this is a bound, not a proof."}</p>`;
      root.dataset.yopt = yOpt.join(",");
    };
    set = bind(root, st, draw, { b1: (v) => `${v} h`, b2: String, y1: (v) => money(v), y2: (v) => money(v) });
    root.querySelector("[data-act=opt]").addEventListener("click", () => {
      const [a, bb] = root.dataset.yopt.split(",").map(Number);
      set("y1", a); set("y2", bb); draw();
    });
  }
</script>
