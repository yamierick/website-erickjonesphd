---
import Base from "../layouts/Base.astro";

/**
 * The index is meant to be read, not just clicked through. Each model here
 * exists to make exactly one mechanism visible, so the card states that
 * mechanism rather than describing the interface — a visitor should be able to
 * tell which model answers their question without opening either.
 *
 * The thumbnails are hand-drawn abstractions of each model's actual chart, not
 * screenshots. Screenshots would go stale the moment a model changed, would
 * need regenerating by hand, and would not follow the reader's theme. These are
 * a few hundred bytes, track light and dark, and each one shows the shape that
 * IS the argument: proportions inverting across the cascade, and a supply band
 * arriving too late to close a gap. They are decorative — the card text carries
 * the meaning — so they are hidden from assistive technology rather than given
 * alt text that would only repeat the heading.
 */

// Ore narrowing to metal while the ranking flips: thick copper band thinning
// out, thin steel band thickening, crossing on the way.
const artCascade = `
<svg viewBox="0 0 240 86" class="thumb" aria-hidden="true" focusable="false">
  <path d="M 19 8 C 116 8, 116 30, 214 30 L 214 40 C 116 40, 116 50, 19 50 Z"
        fill="var(--th-copper)" fill-opacity=".55"/>
  <path d="M 19 56 C 116 56, 116 44, 214 44 L 214 72 C 116 72, 116 68, 19 68 Z"
        fill="var(--th-steel)" fill-opacity=".55"/>
  <rect x="14" y="6" width="5" height="64" rx="1.5" fill="var(--th-copper)" fill-opacity=".9"/>
  <rect x="76" y="14" width="5" height="52" rx="1.5" fill="var(--muted)" fill-opacity=".8"/>
  <rect x="148" y="20" width="5" height="46" rx="1.5" fill="var(--muted)" fill-opacity=".8"/>
  <rect x="214" y="28" width="5" height="46" rx="1.5" fill="var(--th-steel)" fill-opacity=".9"/>
</svg>`;

// Demand climbing away from supply, with the recovered band arriving late and
// too small to close the gap it opens.
const artRecovery = `
<svg viewBox="0 0 240 86" class="thumb" aria-hidden="true" focusable="false">
  <path d="M 12 74 L 12 58 L 84 54 L 156 50 L 228 46 L 228 74 Z"
        fill="var(--muted)" fill-opacity=".38"/>
  <path d="M 12 58 L 84 54 L 156 44 L 228 32 L 228 46 L 156 50 L 84 54 Z"
        fill="var(--accent)" fill-opacity=".65"/>
  <path d="M 12 60 L 84 44 L 156 28 L 228 12"
        fill="none" stroke="var(--text)" stroke-width="2" stroke-linejoin="round"/>
  <line x1="12" y1="74" x2="228" y2="74" stroke="var(--rule)" stroke-width="1"/>
</svg>`;

const models = [
  {
    title: "What a Grid Is Made Of",
    url: "/materials/",
    art: artCascade,
    line: "Energy demand → the generation that meets it → components → metal → rock.",
    thesis:
      "Copper is a few percent of the metal and the large majority of the rock. Steel dominates "
      + "the tonnage — a wind tower is a very heavy object — while copper, which nobody weighs, "
      + "dominates the mining.",
    detail:
      "Pick a generation mix and it tells you what that mix is made of. Two timescales: over a "
      + "year, the fleet run flat out against annual demand; over one day, the share of demand "
      + "the battery carries.",
  },
  {
    title: "A Toy Linked Model",
    url: "/recovery-loop/",
    art: artRecovery,
    line: "Battery demand → critical mineral demand → primary mining and end-of-life recovery.",
    thesis:
      "The recovery loop is a supply source whose size was set by decisions taken ten to fifteen "
      + "years earlier. You cannot ramp it in the year you discover you need it.",
    detail:
      "A deterministic stock-and-flow sketch. Push demand growth until a shortfall opens, then "
      + "try to close it by raising the recovery yield — the material simply is not in the waste "
      + "stream yet.",
  },
];
---

<Base title="Models" wide={true} og="models">
  <p class="subhead">Small interactive models, each built to make one mechanism visible.</p>

  <p class="disclaimer">
    <strong>These are teaching toys, not research.</strong> They run on fixed
    coefficients, nothing in them is optimized, and no number they produce
    should be cited. What they are good for is the shape of an argument — the
    thing that is hard to see in a table and obvious once you can move it.
  </p>

  <ul class="models">
    {models.map((m) => (
      <li>
        <div class="art"><Fragment set:html={m.art} /></div>
        <h2><a href={m.url}>{m.title}</a></h2>
        <p class="line">{m.line}</p>
        <p class="thesis">{m.thesis}</p>
        <p class="detail">{m.detail}</p>
      </li>
    ))}
  </ul>

  <h2 class="plain">Where the numbers come from</h2>
  <p>
    Every coefficient in these models says which kind it is — a published
    figure from the IEA, EIA or USGS, or an order-of-magnitude estimate made
    for the page. Roughly a third are estimates. That is fine for arguments
    that turn on ratios of two hundred to one rather than on ten percent
    accuracy, but it is not fine to hide, so the label travels with the number
    and every model carries its figures as a table as well as a picture.
  </p>
  <p>
    Where a model cannot compute something, it says so and does not draw it.
    The day-shape diagram on <a href="/materials/">What a Grid Is Made Of</a>
    is a schematic that deliberately does not respond to the controls, because
    the model underneath has no time resolution and a diagram that reacted to
    the sliders would be claiming to have calculated something it has not.
  </p>
  <p class="hint">
    The real versions of these questions — a mix that is chosen rather than
    given, under capacity limits, lead times and recovery — are the actual
    research, and do not fit on a web page. That work lives in
    <a href="/labs/">the lab</a> and in <a href="/publications/">the papers</a>.
  </p>
</Base>

<style>
  .disclaimer {
    border-left: 3px solid var(--accent);
    padding: .6rem .9rem;
    background: var(--code-bg);
    font-size: .92rem;
  }

  .models {
    list-style: none; padding: 0; margin: 1.5rem 0; display: grid; gap: 1.1rem;
    --th-copper: #9c4f1c;
    --th-steel: #39424b;
  }
  @media (prefers-color-scheme: dark) {
    .models { --th-copper: #f0b57e; --th-steel: #6b7682; }
  }
  @media (min-width: 52rem) {
    .models { grid-template-columns: 1fr 1fr; }
  }

  .models li {
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 0 0 1.1rem;
    overflow: hidden;
    /* The whole card is the click target — see the stretched link below. */
    position: relative;
    transition: border-color .15s ease, background-color .15s ease;
  }
  .models li:hover { border-color: var(--accent); background: var(--code-bg); }

  .art {
    background: var(--code-bg);
    border-bottom: 1px solid var(--rule);
    padding: .5rem .9rem;
  }
  .art :global(svg.thumb) { display: block; width: 100%; height: auto; }

  .models h2 { margin: .9rem 1.1rem .3rem; font-size: 1.18rem; }
  .models h2 a { text-decoration: none; }
  .models h2 a:hover { text-decoration: underline; }
  /* Stretched link: one link in the accessibility tree, a whole card to click. */
  .models h2 a::after { content: ""; position: absolute; inset: 0; }

  .models .line {
    font-family: system-ui, sans-serif;
    font-size: .82rem;
    color: var(--muted);
    margin: 0 1.1rem .7rem;
  }
  .models .thesis { margin: 0 1.1rem .6rem; font-size: .96rem; }
  .models .detail {
    font-family: system-ui, sans-serif;
    font-size: .84rem;
    color: var(--muted);
    margin: 0 1.1rem;
  }

  h2.plain { margin-top: 2rem; }
  .hint { font-family: system-ui, sans-serif; font-size: .82rem; color: var(--muted); }
</style>
