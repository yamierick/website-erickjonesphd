---
import Base from "../layouts/Base.astro";

/**
 * Approved by Jones for publication on 2026-10-11, after his UTA outside-
 * activity disclosure was filed.
 *
 * Resources becomes the consulting soft sell (Jones, 2026-10-01 and 10-11).
 * The worked examples it used to list (now Python notebooks, apart from the
 * city models) are all linked from Teaching
 * (the course pages and "Earlier materials"), and keep their /resources/<slug>/
 * addresses.
 *
 * Constraints, from the ventures chat (2026-10-11):
 * - No firm name yet: Jones consulting personally, "consulting enquiries
 *   welcome". No venture, partner, client, site or deal named; no pricing.
 * - Texas Occupations Code 1001.405: a business may not offer or advertise
 *   engineering services without a TBPELS firm registration. Design-type work
 *   (pre-FEED, facility and process design, data-centre design, RFID system
 *   design) is described as expertise, not offered as a service, and
 *   "engineering services" stays out of the call to action. "PE" as his own
 *   credential is fine.
 * - UTA outside-activity and conflict-of-interest disclosure: filed
 *   (Jones, 2026-10-11). The page keeps "separate from my role at UT
 *   Arlington" at his request, to make the line clear.
 * - Contact: his personal address, chosen 2026-10-11, not a UTA address.
 */
const CONTACT = "erickcjonesjr@gmail.com";

const lines = [
  {
    title: "AI and analytics for operations",
    lead: "Turn scattered data and documents into models and decisions.",
    items: [
      "Cleaning up operational data and document stores so they can be analysed",
      "AI assistants that work on a company's own files and data",
      "Automating production data acquisition and reporting",
      "Taking a business beyond Excel and Power BI",
      "Optimization, simulation and surrogate models for decisions too large to try by hand",
    ],
  },
  {
    title: "Inventory, RFID and tracking",
    lead: "From a first inventory database to RFID across a facility.",
    items: [
      "Inventory and production systems: what to track, how often, and what to do with it",
      "RFID and auto-ID: tag and reader selection, testing and pilots",
      "GS1 preparation, RAIN RFID standards and retailer supplier mandates",
    ],
  },
  {
    title: "Operations and process improvement",
    lead: "Measure the operation, then improve it.",
    items: [
      "Operational benchmarking against peers and against the operation's own best weeks",
      "Lean and Six Sigma",
      "Data-driven process improvement, with AI where it earns its place",
    ],
  },
  {
    title: "Energy, environment and community fit",
    lead: "Energy and infrastructure projects that need to work for the people around them.",
    items: [
      "Energy system and supply-chain modelling for strategic and operational planning",
      "Policy planning and impact analysis",
      "Life-cycle and techno-economic assessment (LCA and TEA)",
      "Zoning compliance and community engagement: helping companies follow zoning law and listen to the communities around their sites, so new facilities are good neighbours",
    ],
  },
  {
    title: "Assessment and due diligence",
    lead: "An independent read before money is committed.",
    items: [
      "Business strategy assessment",
      "Investment due diligence on energy, materials and operations assets",
      "Early-stage project assessment, before front-end engineering",
    ],
  },
];
---

<Base title="Resources" description="Consulting on data, operations, inventory and RFID, and energy projects, from Erick C. Jones Jr., PhD, PE.">

  <p class="subhead">Put your data, documents and inventory to work.</p>

  <p>
    Alongside my faculty role I take on a small number of consulting
    engagements for businesses and public bodies: companies with messy
    operational data, organisations with inventory and tracking problems, and
    energy or infrastructure projects that want to be good neighbours to the
    communities around them.
  </p>
  <p>
    I am a licensed Professional Engineer in Texas. Before academia I worked as a
    process engineer at AMEC Foster Wheeler and a project engineer at Johnson
    Controls, and my <a href="/research/">research</a> covers the same ground:
    energy and critical-mineral supply chains, optimization and simulation, and
    RFID and asset tracking.
  </p>

  {lines.map((l) => (
    <section class="line">
      <h2>{l.title}</h2>
      <p class="lead">{l.lead}</p>
      <ul>{l.items.map((i) => <li>{i}</li>)}</ul>
    </section>
  ))}

  <h2>Also within my expertise</h2>
  <p>
    Facility layout, operation and process design, data-centre planning, and
    RFID system design. These are engineering work under Texas law, so I discuss
    them as background and advice here rather than offering them as services.
  </p>

  <h2>Get in touch</h2>
  <p>
    Consulting enquiries are welcome: <a href={`mailto:${CONTACT}`}>{CONTACT}</a>. A short description of the
    problem is enough to start.
  </p>

  <p class="hint">
    Looking for the free teaching materials that used to be here? They are on
    <a href="/teaching/">Teaching</a>, with the course each one belongs to. Consulting
    is personal outside work, separate from my role at UT Arlington.
  </p>
</Base>

<style>
  .line { margin-top: 1.6rem; }
  .line h2 { margin-bottom: .2rem; }
  .line .lead { margin-top: 0; color: var(--muted); font-style: italic; }
  .hint { font-family: system-ui, sans-serif; font-size: .85rem; color: var(--muted); margin-top: 2rem; }
</style>
