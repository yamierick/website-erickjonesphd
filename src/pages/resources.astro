---
import Base from "../layouts/Base.astro";

// These 14 pages are R Markdown output containing raw HTML, code blocks, and
// embedded figures. They are served verbatim from public/resources/ rather than
// being converted to MDX, which would mangle them. Astro copies public/ through
// untouched, so the original rendering is preserved exactly.
//
// `figure` is the most representative plot from each page, pulled from its own
// output. Ten of the fourteen have one; the remaining four are code-only
// (solver examples and decomposition walkthroughs) and appear in the full list
// below rather than in the band. Paths are pre-encoded because the R Markdown
// figure directories contain spaces.
const posts = [
  { slug: "stat-basics",       title: "Statistic Basics and Linear Regression",  date: "January 1, 2020",
    figure: "/blog/ORIE/Stat%20Basics/Stat_basics_files/figure-html/unnamed-chunk-3-1.png",
    alt: "Regression diagnostics" },
  { slug: "simulation-basics", title: "The Basics of Simulation",                date: "January 2, 2020",
    figure: "/blog/ORIE/Simulation%20Basics/Simulation_basics_files/figure-html/unnamed-chunk-1-1.png",
    alt: "Simulation output distribution" },
  { slug: "lp-algorithms",     title: "Linear Programming Examples and Applications", date: "January 3, 2020",
    figure: "/blog/ORIE/LP%20Algorithms/LP_algorithms_files/figure-html/unnamed-chunk-3-1.png",
    alt: "A linear programming feasible region" },
  { slug: "markov-chains",     title: "Basics of Markov Chains",                 date: "January 4, 2020",
    figure: "/blog/ORIE/Markov%20Chains/markovchains_files/figure-html/unnamed-chunk-3-1.png",
    alt: "Markov chain state probabilities" },
  { slug: "gurobi-examples",   title: "Gurobi Basic LP/MIP Examples",            date: "January 5, 2020" },
  { slug: "gurobi-examples-2", title: "Gurobi's R Examples 2",                   date: "January 6, 2020" },
  { slug: "qp-modeling",       title: "Quadratic Programming Examples and Algorithms", date: "January 7, 2020",
    figure: "/blog/ORIE/QP%20Modeling/QP_algorithms_files/figure-html/gradient_descent_example-1.png",
    alt: "Gradient descent on a quadratic surface" },
  { slug: "bender-decomp",     title: "Benders Decomposition Algorithm Explained", date: "January 9, 2020" },
  { slug: "decomp-algorithms", title: "Decomposition Algorithms Broken Down and Explained", date: "January 10, 2020" },
  { slug: "sentimentanalysis", title: "Natural Language Processing — Sentiment Analysis", date: "March 21, 2020",
    figure: "/resources/sentimentanalysis/dropoutrate.png",
    alt: "Dropout rate analysis" },
  { slug: "slsdesign",         title: "A Selective Laser Sintering Creation — Wind Powered Tops", date: "March 21, 2020",
    figure: "/resources/slsdesign/sls-top-designs.png",
    alt: "Selective laser sintering top designs" },
  { slug: "city-modeling",     title: "Monocentric City Modeling",               date: "March 3, 2019",
    figure: "/blog/ORIE/City%20Modeling/Modeling_City_files/figure-html/unnamed-chunk-9-1.png",
    alt: "Monocentric city density gradient" },
  { slug: "sci-res-city",      title: "Sim CCS City",                            date: "May 3, 2019",
    figure: "/blog/ORIE/Sci%20Res%20City/Sci_Res_City2_files/figure-html/unnamed-chunk-9-1.png",
    alt: "Carbon capture siting model output" },
  { slug: "austin-land-use",   title: "Austin Land Use",                         date: "September 21, 2018",
    // card.jpg is a 900px derivative; the page itself still serves the full
    // 1342px PNG. 474 KB was too much for a thumbnail.
    figure: "/resources/austin-land-use/card.jpg",
    alt: "Austin land use map" },
];

const featured = posts.filter((p) => p.figure);
---

<Base title="Resources" wide={true}>
  <p>Free, open teaching materials and worked examples from my courses — operations research, optimization solvers, simulation, and statistics, mostly in reproducible R Markdown. Originally written for students; useful to anyone learning the tools.</p>

  <div class="feature-grid">
    {featured.map((p) => (
      <a class="feature-card" href={`/resources/${p.slug}/`}>
        <img src={p.figure} alt={p.alt} loading="lazy" decoding="async">
        <div class="feature-card-body">
          <h2>{p.title}</h2>
          <p class="feature-meta">{p.date}</p>
        </div>
      </a>
    ))}
  </div>

  <hr class="feature-rule">

  <h2 class="pub-year">All resources</h2>
  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <time>{p.date}</time>
        <a href={`/resources/${p.slug}/`}>{p.title}</a>
      </li>
    ))}
  </ul>
</Base>

<style is:global>
  .feature-grid {
    display: grid;
    gap: .9rem;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    margin: 1.25rem 0 0;
  }
  .feature-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: var(--bg);
    transition: border-color .15s ease, transform .15s ease;
  }
  .feature-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  /* Plots are mostly white-background R output; `contain` keeps axes readable
     and avoids cropping the legend off, which `cover` would do. */
  .feature-card img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: contain;
    background: #fff;
    display: block;
    padding: .35rem;
  }
  .feature-card-body { padding: .6rem .8rem .85rem; }
  .feature-card-body h2 {
    margin: 0 0 .25rem;
    font-size: .92rem;
    line-height: 1.3;
    color: var(--accent);
  }
  .feature-meta { margin: 0; font-family: system-ui, sans-serif; font-size: .76rem; color: var(--muted); }
  .feature-rule { border: 0; border-top: 1px solid var(--rule); margin: 2rem 0 .5rem; }
</style>
