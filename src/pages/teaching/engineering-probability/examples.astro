---
import Base from "../../../layouts/Base.astro";
import { t, d } from "../../../lib/tex.js";
import { plot, normalPdf, tPdf } from "../../../lib/fig.js";
import DOEExplorer from "../../../components/teach/DOEExplorer.astro";
import RegressionExplorer from "../../../components/teach/RegressionExplorer.astro";
import PowerExplorer from "../../../components/teach/PowerExplorer.astro";
import JointExplorer from "../../../components/teach/JointExplorer.astro";
import CLTExplorer from "../../../components/teach/CLTExplorer.astro";
import DistributionExplorer from "../../../components/teach/DistributionExplorer.astro";
import "katex/dist/katex.min.css";
import "../../../styles/examples.css";

/**
 * IE 3301 worked examples (Jones, 2026-10-12): distributions and their means
 * and variances, covariance and correlation of a custom joint distribution,
 * normal and t, a hypothesis test, regression, and a first 2x2 design of
 * experiments. The data sets are made up for teaching and say so on the page.
 * Every number was checked in Python (scipy.stats) before it was written down.
 */

// ---- Discrete --------------------------------------------------------------
const dx = [0, 1, 2, 3], dp = [0.5, 0.3, 0.15, 0.05], dm = 0.75, dsd = Math.sqrt(0.7875);
const disc = plot({ w: 420, h: 280, x: [-0.6, 3.6], y: [0, 0.6] })
  .axes({ xt: [0, 1, 2, 3], yt: [0, 0.2, 0.4, 0.6], xl: "defective parts in a box, x", yl: "P(X = x)", grid: true, yfmt: (v) => v.toFixed(1) })
  .rect(dm - dsd, 0, dm + dsd, 0.6, "fill-b");
dx.forEach((x, i) => disc.rect(x - 0.28, 0, x + 0.28, dp[i], "bar").text(x, dp[i], dp[i].toFixed(2), { anchor: "middle", dy: -5 }));
disc.line([[dm, 0], [dm, 0.6]], "dash-a").text(dm, 0.57, "mean 0.75", { cls: "accent", dx: 4 })
  .text(dm + dsd, 0.5, "±1 SD", { dx: 4 });
const discSvg = disc.svg("Bar chart of a custom distribution: P(X=0)=0.5, P(X=1)=0.3, P(X=2)=0.15, P(X=3)=0.05. The mean, 0.75, is marked, with a band one standard deviation (0.89) either side.");


// ---- Continuous --------------------------------------------------------------
const cont = plot({ w: 320, h: 240, x: [0, 1], y: [0, 3], pad: [26, 10, 38, 36] })
  .axes({ xt: [0, 0.25, 0.5, 0.75, 1], yt: [0, 1, 2, 3], xl: "x", xfmt: (v) => String(v) })
  .under((x) => 3 * x * x, 0, 0.5, "fill")
  .fn((x) => 3 * x * x, 0, 1, "ln-a")
  .line([[0.75, 0], [0.75, 3]], "dash-a").text(0.73, 2.75, "mean 0.75", { cls: "accent", anchor: "end" })
  .text(0.2, 0.55, "P(X ≤ 0.5) = 0.125").text(0.04, 2.75, "f(x) = 3x²", { cls: "lab" });
const contSvg = cont.svg("The density f(x) = 3x² on [0, 1], rising to 3 at x = 1. The area to the left of 0.5 is shaded: 0.125. The mean, 0.75, is marked.");

const ex = plot({ w: 320, h: 240, x: [0, 800], y: [0, 0.005], pad: [26, 10, 38, 50] })
  .axes({ xt: [0, 200, 400, 600, 800], yt: [0, 0.0025, 0.005], xl: "hours to failure, t", yfmt: (v) => v.toFixed(4) })
  .under((x) => Math.exp(-x / 200) / 200, 300, 800, "fill")
  .fn((x) => Math.exp(-x / 200) / 200, 0, 800, "ln-a")
  .line([[200, 0], [200, 0.005]], "dash-a").text(205, 0.0046, "mean 200", { cls: "accent" })
  .text(380, 0.0012, "P(T > 300) = 0.223").text(330, 0.0042, "exponential, mean 200 h", { cls: "lab" });
const exSvg = ex.svg("Exponential density with mean 200 hours, decaying from 0.005 at zero. The area beyond 300 hours is shaded: 0.223.");

// ---- Joint -----------------------------------------------------------------
const J = [[0.30, 0.15, 0.05], [0.10, 0.20, 0.20]];
const jt = plot({ w: 420, h: 300, x: [-0.6, 1.6], y: [-0.6, 2.6], pad: [24, 16, 42, 50] })
  .axes({ xt: [0, 1], yt: [0, 1, 2], xl: "X: overtime shift (0 = no, 1 = yes)", yl: "Y: defects found" });
J.forEach((row, x) => row.forEach((p, y) => jt.dot(x, y, "bar", 55 * Math.sqrt(p)).text(x, y, p.toFixed(2), { anchor: "middle", dy: 4, cls: "strong" })));
jt.line([[0.5, -0.6], [0.5, 2.6]], "dash").line([[-0.6, 0.85], [1.6, 0.85]], "dash")
  .text(0.52, 2.45, "E[X] = 0.5").text(1.58, 0.92, "E[Y] = 0.85", { anchor: "end" });
const jtSvg = jt.svg("Bubble chart of the joint distribution: circle areas proportional to probability. Without overtime the mass sits at low defect counts (0.30, 0.15, 0.05); with overtime it shifts up (0.10, 0.20, 0.20). Dashed lines mark the means 0.5 and 0.85.");

// ---- Normal vs t -----------------------------------------------------------
const nt = plot({ w: 520, h: 280, x: [-4, 4], y: [0, 0.42] })
  .axes({ xt: [-4, -3, -2, -1, 0, 1, 2, 3, 4], yt: [0, 0.1, 0.2, 0.3, 0.4], xl: "z or t", yfmt: (v) => v.toFixed(1), grid: true })
  .fn((x) => tPdf(x, 2), -4, 4, "ln-b")
  .fn((x) => tPdf(x, 9), -4, 4, "ln-m")
  .fn((x) => normalPdf(x), -4, 4, "ln-a")
  // Legend, top left, where all three curves are near zero.
  .line([[-3.9, 0.385], [-3.4, 0.385]], "ln-a").text(-3.3, 0.379, "standard normal", { cls: "lab" })
  .line([[-3.9, 0.345], [-3.4, 0.345]], "ln-m").text(-3.3, 0.339, "t, 9 degrees of freedom", { cls: "lab" })
  .line([[-3.9, 0.305], [-3.4, 0.305]], "ln-b").text(-3.3, 0.299, "t, 2 degrees of freedom: heavier tails", { cls: "lab" });
const ntSvg = nt.svg("The standard normal density and the t density with 9 and 2 degrees of freedom. The t curves are lower in the middle and higher in the tails; with more degrees of freedom they approach the normal.");

// ---- Hypothesis test -------------------------------------------------------
const tc = 2.2622, tobs = 3.5375;
const ht = plot({ w: 520, h: 280, x: [-4.5, 4.5], y: [0, 0.42] })
  .axes({ xt: [-4, -2.262, 0, 2.262, 4], yt: [0, 0.2, 0.4], xl: "t statistic (9 degrees of freedom)", xfmt: (v) => (Math.abs(v) === 2.262 ? (v > 0 ? "2.262" : "−2.262") : String(v)), yfmt: (v) => v.toFixed(1) })
  .under((x) => tPdf(x, 9), -4.5, -tc, "fill-w").under((x) => tPdf(x, 9), tc, 4.5, "fill-w")
  .fn((x) => tPdf(x, 9), -4.5, 4.5, "ln-a")
  .text(-3.3, 0.06, "reject H₀: 2.5% in each tail", { cls: "warn", anchor: "middle" })
  .text(0, 0.2, "fail to reject", { anchor: "middle" })
  .line([[tobs, 0], [tobs, 0.3]], "ln").dot(tobs, 0, "pt", 5)
  .text(tobs, 0.32, "observed t = 3.54", { cls: "strong", anchor: "middle" });
const htSvg = ht.svg("The t distribution with 9 degrees of freedom. Both tails beyond plus or minus 2.262 are shaded as the rejection region, 2.5% each. The observed statistic, 3.54, falls in the right-hand rejection region.");

// ---- Regression -------------------------------------------------------------
const rx = [150, 160, 170, 180, 190, 200, 210, 220], ry = [62.1, 64.8, 66.0, 69.3, 70.1, 73.4, 74.0, 77.2];
const b1 = 873.5 / 4200, b0 = 69.6125 - b1 * 185;
const rg = plot({ w: 520, h: 320, x: [145, 225], y: [60, 80] })
  .axes({ xt: [150, 170, 190, 210], yt: [60, 65, 70, 75, 80], xl: "temperature (°C)", yl: "yield (%)", grid: true })
  .line([[145, b0 + b1 * 145], [225, b0 + b1 * 225]], "ln-a");
rx.forEach((x, i) => rg.line([[x, ry[i]], [x, b0 + b1 * x]], "ln-b").dot(x, ry[i], "pt-o", 4));
rg.text(150, 78.6, "ŷ = 31.14 + 0.208 x,  R² = 0.987", { cls: "strong" })
  .text(222, 71.5, "residuals (orange) are what", { anchor: "end" })
  .text(222, 70.4, "least squares makes small", { anchor: "end" });
const rgSvg = rg.svg("Scatter plot of yield against temperature for eight runs, with the fitted line y-hat = 31.14 + 0.208x. Short vertical segments from each point to the line are the residuals.");

// ---- DOE ------------------------------------------------------------------
const dy = { lo: [60, 72], hi: [64, 84] };
const dp2 = plot({ w: 420, h: 280, x: [-1.4, 1.4], y: [55, 90], pad: [24, 16, 40, 50] })
  .axes({ xt: [-1, 1], yt: [60, 70, 80, 90], xl: "temperature (coded: −1 = 150 °C, +1 = 200 °C)", yl: "average yield (%)", xfmt: (v) => (v < 0 ? "−1" : "+1") })
  .line([[-1, dy.lo[0]], [1, dy.lo[1]]], "ln-m").line([[-1, dy.hi[0]], [1, dy.hi[1]]], "ln-a")
  .dot(-1, 60, "pt-m").dot(1, 72, "pt-m").dot(-1, 64, "pt").dot(1, 84, "pt")
  .text(-1, 60, "60", { dx: -10, dy: 4, anchor: "end" }).text(1, 72, "72", { dx: 10, dy: 4 })
  .text(-1, 64, "64", { dx: -10, dy: 4, anchor: "end" }).text(1, 84, "84", { dx: 10, dy: 4 })
  .text(0.95, 86.5, "time long (+1)", { cls: "accent", anchor: "end" })
  .text(-0.25, 61.2, "time short (−1)");
const doeSvg = dp2.svg("Interaction plot for the 2 by 2 experiment. With a short time, yield rises from 60 to 72 as temperature goes from low to high; with a long time it rises from 64 to 84. The lines are not parallel, which is the interaction.");
---

<Base title="IE 3301 Worked Examples" wide={true} description="Engineering Probability, interactive: explore distributions, watch the central limit theorem, build a correlation, see Type I and II errors and power, fit a regression by clicking, and run a 2×2 designed experiment.">
<div class="ex">
  <p class="crumbs"><a href="/teaching/">Teaching</a> · <a href="/teaching/engineering-probability/">IE 3301 Engineering Probability</a> · Worked examples</p>

  <p>
    Each section has one idea, a short explanation and something to try. The worked example is folded
    underneath, and it shows its work the same way every time:
  </p>
  <ol class="steps">
    <li><strong>Write out the equation.</strong></li>
    <li><strong>List the variables</strong>: the terms in that equation.</li>
    <li><strong>Fill in the equation</strong> with the numbers.</li>
    <li><strong>Simplify, and box the answer.</strong></li>
  </ol>
  <ol class="toc">
    <li><a href="#dist">Distributions: mean, variance and area</a></li>
    <li><a href="#clt">The central limit theorem</a></li>
    <li><a href="#joint">Covariance and correlation</a></li>
    <li><a href="#test">Hypothesis tests, errors and power</a></li>
    <li><a href="#regression">Linear regression</a></li>
    <li><a href="#doe">A designed experiment</a></li>
  </ol>

  <!-- 1 ------------------------------------------------------------------ -->
  <section id="dist">
    <h2>1. Distributions: mean, variance and area</h2>
    <ul class="able">
      <li>Calculate the mean, variance and standard deviation of a distribution</li>
      <li>Find a probability as a sum (discrete) or an area (continuous)</li>
      <li>Recognize the common distributions and what they model</li>
    </ul>
    <p class="demo-lead">
      A discrete variable counts and has a pmf (bars that sum to 1); a continuous one measures and has a pdf (a
      curve with area 1), where probability is area. The mean is the balance point,
      <Fragment set:html={t`\mu = \sum x\,p(x)`} /> or <Fragment set:html={t`\int x f(x)\,dx`} />, and the variance is <Fragment set:html={t`E[X^2] - \mu^2`} />.
    </p>

    <DistributionExplorer />

    <details class="full">
      <summary>Worked example: defective parts in a box (discrete)</summary>
      <p><Fragment set:html={t`X`} /> = 0, 1, 2 or 3 defective parts, with probabilities 0.50, 0.30, 0.15 and 0.05.</p>
      <ol class="steps">
        <li><strong>Equations:</strong> <Fragment set:html={t`\mu = \sum x\,p(x)`} />, <Fragment set:html={t`\sigma^2 = \sum x^2 p(x) - \mu^2`} />.</li>
        <li><strong>Variables:</strong> <Fragment set:html={t`x = 0, 1, 2, 3`} />; <Fragment set:html={t`p(x) = 0.50, 0.30, 0.15, 0.05`} /> (they sum to 1).</li>
        <li><strong>Fill in:</strong> <Fragment set:html={t`\mu = 0 + 0.30 + 0.30 + 0.15`} />; <Fragment set:html={t`\sigma^2 = (0.30 + 0.60 + 0.45) - 0.75^2`} />.</li>
        <li><strong>Answer:</strong> <span class="answer"><Fragment set:html={t`\mu = 0.75,\ \sigma^2 = 0.7875,\ \sigma \approx 0.887`} /></span></li>
      </ol>
      <figure class="fig"><Fragment set:html={discSvg} /><figcaption>The mean is the balance point; the band is one standard deviation either side.</figcaption></figure>
    </details>
    <details class="full">
      <summary>Worked examples: probability as area (continuous)</summary>
      <p><strong>A.</strong> <Fragment set:html={t`f(x) = 3x^2`} /> on 0 to 1. <strong>Equation</strong> <Fragment set:html={t`P(X \le a) = \int_0^a f(x)\,dx`} />; <strong>fill in</strong> <Fragment set:html={t`\int_0^{0.5} 3x^2\,dx = 0.5^3`} />; <strong>answer</strong> <span class="answer">0.125</span>. Its mean is <Fragment set:html={t`\int_0^1 3x^3\,dx = 0.75`} />.</p>
      <p><strong>B.</strong> Pump life is exponential with mean 200 h. <strong>Equation</strong> <Fragment set:html={t`P(T > t) = e^{-t/\text{mean}}`} />; <strong>fill in</strong> <Fragment set:html={t`e^{-300/200}`} />; <strong>answer</strong> <span class="answer"><Fragment set:html={t`P(T > 300) \approx 0.223`} /></span></p>
      <figure class="fig pair"><Fragment set:html={contSvg} /><Fragment set:html={exSvg} /><figcaption>The shaded areas are the answers.</figcaption></figure>
    </details>
    <details class="full">
      <summary>The common distributions at a glance</summary>
      <div class="scroll"><table class="num left">
        <thead><tr><th>Distribution</th><th>Models</th><th>pmf or pdf</th><th>Mean</th><th>Variance</th></tr></thead>
        <tbody>
          <tr><td>Binomial(<Fragment set:html={t`n, p`} />)</td><td>successes in <Fragment set:html={t`n`} /> trials</td><td><Fragment set:html={t`\binom{n}{x}p^x(1-p)^{n-x}`} /></td><td><Fragment set:html={t`np`} /></td><td><Fragment set:html={t`np(1-p)`} /></td></tr>
          <tr><td>Geometric(<Fragment set:html={t`p`} />)</td><td>trials until the first success</td><td><Fragment set:html={t`(1-p)^{x-1}p`} /></td><td><Fragment set:html={t`1/p`} /></td><td><Fragment set:html={t`(1-p)/p^2`} /></td></tr>
          <tr><td>Poisson(<Fragment set:html={t`\lambda`} />)</td><td>events in an interval</td><td><Fragment set:html={t`e^{-\lambda}\lambda^x/x!`} /></td><td><Fragment set:html={t`\lambda`} /></td><td><Fragment set:html={t`\lambda`} /></td></tr>
          <tr><td>Uniform(<Fragment set:html={t`a, b`} />)</td><td>equally likely in a range</td><td><Fragment set:html={t`1/(b-a)`} /></td><td><Fragment set:html={t`(a+b)/2`} /></td><td><Fragment set:html={t`(b-a)^2/12`} /></td></tr>
          <tr><td>Exponential(<Fragment set:html={t`\lambda`} />)</td><td>time between random events</td><td><Fragment set:html={t`\lambda e^{-\lambda x}`} /></td><td><Fragment set:html={t`1/\lambda`} /></td><td><Fragment set:html={t`1/\lambda^2`} /></td></tr>
          <tr><td>Normal(<Fragment set:html={t`\mu, \sigma^2`} />)</td><td>sums and averages</td><td><Fragment set:html={t`\frac{1}{\sigma\sqrt{2\pi}}e^{-(x-\mu)^2/2\sigma^2}`} /></td><td><Fragment set:html={t`\mu`} /></td><td><Fragment set:html={t`\sigma^2`} /></td></tr>
        </tbody>
      </table></div>
    </details>
  </section>

  <!-- 2 ------------------------------------------------------------------ -->
  <section id="clt">
    <h2>2. The central limit theorem</h2>
    <ul class="able">
      <li>State the central limit theorem</li>
      <li>Find the standard error of a sample mean, σ/√n</li>
      <li>Explain when to use t instead of z</li>
    </ul>
    <p class="demo-lead">
      Average enough independent observations and the average is approximately normal, whatever the population
      looks like, with mean <Fragment set:html={t`\mu`} /> and standard error <Fragment set:html={t`\sigma/\sqrt n`} />. That is why the normal is everywhere,
      and why <Fragment set:html={t`z = (\bar x - \mu)/(\sigma/\sqrt n)`} /> works. When <Fragment set:html={t`\sigma`} /> is estimated from the sample, use t instead: it has
      heavier tails, and approaches the normal as <Fragment set:html={t`n`} /> grows (try it in the explorer above).
    </p>

    <CLTExplorer />

    <details class="full">
      <summary>Worked example: bolts longer than 50.8 mm</summary>
      <p>Lengths are normal, mean 50 mm, SD 0.4 mm.</p>
      <ol class="steps">
        <li><strong>Equation:</strong> <Fragment set:html={t`z = (x - \mu)/\sigma`} />.</li>
        <li><strong>Variables:</strong> <Fragment set:html={t`x = 50.8,\ \mu = 50,\ \sigma = 0.4`} />.</li>
        <li><strong>Fill in:</strong> <Fragment set:html={t`z = 0.8/0.4 = 2`} />; look up <Fragment set:html={t`P(Z > 2)`} />.</li>
        <li><strong>Answer:</strong> <span class="answer">about 2.3% of bolts</span></li>
      </ol>
      <figure class="fig"><Fragment set:html={ntSvg} /><figcaption>The t distribution's heavier tails: its 95% critical value is 2.26 at 9 degrees of freedom, against 1.96 for z.</figcaption></figure>
    </details>
  </section>

  <!-- 3 ------------------------------------------------------------------ -->
  <section id="joint">
    <h2>3. Covariance and correlation</h2>
    <ul class="able">
      <li>Find marginal distributions from a joint table</li>
      <li>Calculate covariance and correlation</li>
      <li>Check whether two variables are independent</li>
    </ul>
    <p class="demo-lead">
      A joint table gives the probability of each pair of values. Add up a row or column for one variable on its
      own (the marginal). <Fragment set:html={t`\operatorname{Cov}(X,Y) = E[XY] - E[X]E[Y]`} /> is positive when the two tend to be high together;
      correlation <Fragment set:html={t`\rho = \operatorname{Cov}/(\sigma_X\sigma_Y)`} /> scales it to between −1 and 1. Independent means every cell equals
      its row total times its column total.
    </p>

    <JointExplorer />

    <details class="full">
      <summary>Worked example: overtime and defects</summary>
      <p>The explorer starts on this table: <Fragment set:html={t`X = 1`} /> for an overtime shift, <Fragment set:html={t`Y`} /> = defects found.</p>
      <ol class="steps">
        <li><strong>Equations:</strong> <Fragment set:html={t`\operatorname{Cov} = E[XY] - E[X]E[Y]`} />, <Fragment set:html={t`\rho = \operatorname{Cov}/(\sigma_X\sigma_Y)`} />.</li>
        <li><strong>Variables:</strong> <Fragment set:html={t`E[X] = 0.5,\ \sigma_X^2 = 0.25`} />; <Fragment set:html={t`E[Y] = 0.85,\ \sigma_Y^2 = 1.35 - 0.85^2 = 0.6275`} />; <Fragment set:html={t`E[XY] = (1)(1)(0.20) + (1)(2)(0.20) = 0.60`} />.</li>
        <li><strong>Fill in:</strong> <Fragment set:html={t`\operatorname{Cov} = 0.60 - (0.5)(0.85)`} />; <Fragment set:html={t`\rho = 0.175/\sqrt{0.25 \times 0.6275}`} />.</li>
        <li><strong>Answer:</strong> <span class="answer"><Fragment set:html={t`\operatorname{Cov} = 0.175,\ \rho \approx 0.44`} /></span>. Not independent: <Fragment set:html={t`0.30 \ne 0.5 \times 0.4`} />.</li>
      </ol>
      <p class="note-box">Correlation is not causation: overtime might cause defects, or a rush order might cause both. A designed experiment (section 6) is how to tell.</p>
    </details>
  </section>

  <!-- 4 ------------------------------------------------------------------ -->
  <section id="test">
    <h2>4. Hypothesis tests, errors and power</h2>
    <ul class="able">
      <li>State the hypotheses and find the critical value</li>
      <li>Decide with the test statistic or the confidence interval</li>
      <li>Explain Type I and Type II errors, the p-value and power</li>
    </ul>
    <p class="demo-lead">
      The critical values are the bounds of the confidence interval; the rejection region is everything outside.
      Reject <Fragment set:html={t`H_0`} /> if the test statistic falls outside them, or, the same thing, if the confidence interval misses
      <Fragment set:html={t`\mu_0`} />. For a two-sided test, put <Fragment set:html={t`\alpha/2`} /> in each tail.
    </p>
    <div class="scroll"><table class="num">
      <thead><tr><th></th><th>H₀ is true</th><th>H₀ is false</th></tr></thead>
      <tbody>
        <tr><td>Reject H₀</td><td>Type I error (probability α)</td><td>correct: power, 1 − β</td></tr>
        <tr><td>Fail to reject H₀</td><td>correct</td><td>Type II error (probability β)</td></tr>
      </tbody>
    </table></div>

    <PowerExplorer />

    <details class="full">
      <summary>Worked example: is the bolt machine off target?</summary>
      <p>Ten bolts (mm): 50.3, 49.8, 50.6, 50.9, 50.2, 50.7, 49.9, 50.5, 50.8, 50.4. Target 50 mm, α = 0.05.</p>
      <ol class="steps">
        <li><strong>Hypotheses:</strong> <Fragment set:html={t`H_0: \mu = 50`} />, <Fragment set:html={t`H_1: \mu \ne 50`} />.</li>
        <li><strong>Equation:</strong> <Fragment set:html={t`t = (\bar x - \mu_0)/(s/\sqrt n)`} /> (σ unknown, so t).</li>
        <li><strong>Variables:</strong> <Fragment set:html={t`\bar x = 50.41,\ s = 0.3665,\ n = 10`} />; critical value <Fragment set:html={t`t_{0.025,\,9} = 2.262`} />.</li>
        <li><strong>Fill in:</strong> <Fragment set:html={t`t = 0.41/(0.3665/\sqrt{10}) = 0.41/0.1159`} />.</li>
        <li><strong>Answer:</strong> <span class="answer"><Fragment set:html={t`t = 3.54 > 2.262`} />: reject H₀</span> (p ≈ 0.006). Same by the interval: <Fragment set:html={t`50.41 \pm 2.262(0.1159) = (50.15, 50.67)`} /> misses 50.</li>
      </ol>
      <figure class="fig"><Fragment set:html={htSvg} /><figcaption>The rejection region holds 5% of the t distribution; the observed t lands inside it.</figcaption></figure>
    </details>
  </section>

  <!-- 5 ------------------------------------------------------------------ -->
  <section id="regression">
    <h2>5. Linear regression</h2>
    <ul class="able">
      <li>Fit a least-squares line</li>
      <li>Interpret the slope and R²</li>
      <li>Check the residuals</li>
      <li>Read the confidence band for the mean and the prediction band for one new point</li>
    </ul>
    <p class="demo-lead">
      Least squares picks the line that makes the squared vertical distances to the points (the residuals) as small
      as possible: <Fragment set:html={t`b_1 = S_{xy}/S_{xx}`} />, <Fragment set:html={t`b_0 = \bar y - b_1\bar x`} />. <Fragment set:html={t`R^2`} /> is the share of the variation the line
      explains.
    </p>

    <RegressionExplorer />

    <details class="full">
      <summary>Worked example: reactor temperature and yield</summary>
      <ol class="steps">
        <li><strong>Equations:</strong> <Fragment set:html={t`b_1 = S_{xy}/S_{xx}`} />, <Fragment set:html={t`b_0 = \bar y - b_1\bar x`} />, <Fragment set:html={t`R^2 = 1 - \text{SSE}/\text{SST}`} />.</li>
        <li><strong>Variables:</strong> <Fragment set:html={t`\bar x = 185,\ \bar y = 69.61,\ S_{xx} = 4200,\ S_{xy} = 873.5`} />.</li>
        <li><strong>Fill in:</strong> <Fragment set:html={t`b_1 = 873.5/4200`} />; <Fragment set:html={t`b_0 = 69.61 - 0.208(185)`} />.</li>
        <li><strong>Answer:</strong> <span class="answer"><Fragment set:html={t`\hat y = 31.14 + 0.208x,\ R^2 = 0.987`} /></span>. The slope test gives <Fragment set:html={t`t \approx 21 > 2.447`} />: temperature matters.</li>
        <li><strong>Error bands at 185 °C</strong> (<Fragment set:html={t`s = \sqrt{\text{SSE}/(n-2)},\ t_{0.025,6} = 2.447`} />): the mean yield is <Fragment set:html={t`\hat y \pm t\,s\sqrt{1/n + (x-\bar x)^2/S_{xx}}`} /> = <span class="answer">69.06 to 70.17</span>; one new run is <Fragment set:html={t`\hat y \pm t\,s\sqrt{1 + 1/n + (x-\bar x)^2/S_{xx}}`} /> = <span class="answer">67.94 to 71.28</span>. The extra 1 under the root is the new run's own scatter.</li>
      </ol>
      <figure class="fig"><Fragment set:html={rgSvg} /><figcaption>The line and its residuals; use it only inside the data, 150 to 220 °C.</figcaption></figure>
    </details>
  </section>

  <!-- 6 ------------------------------------------------------------------ -->
  <section id="doe">
    <h2>6. A designed experiment</h2>
    <ul class="able">
      <li>Lay out a 2×2 factorial design</li>
      <li>Calculate main effects and the interaction</li>
      <li>Read the same results as a regression, and say why each coefficient is half its effect</li>
      <li>Use replicates to estimate the noise and test each effect</li>
      <li>Add a third level to see whether a factor's effect bends</li>
    </ul>
    <p class="demo-lead">
      Regression on data you happened to collect shows association; a designed experiment <em>sets</em> the
      factors, so it can show cause. Run every combination of two factors at two levels (coded −1 and +1), and lay
      the runs out as a table of signs before collecting anything: that table is the data-collection plan, and every
      run feeds every estimate. An effect is the average at + minus the average at −, and the interaction is the same
      for the product column. One run per cell gives the effects but no way to test them; <strong>replicates</strong>
      (repeat runs of each cell) measure the noise. A <strong>third level</strong> of a factor shows whether its effect
      is a straight line or bends.
    </p>

    <DOEExplorer />

    <details class="full">
      <summary>Worked example: temperature and time</summary>
      <ol class="steps">
        <li><strong>Equation:</strong> effect = (average where the column is +) − (average where it is −).</li>
        <li><strong>Variables:</strong> yields 60, 72, 64, 84 at (A, B) = (−, −), (+, −), (−, +), (+, +).</li>
        <li><strong>Fill in:</strong> A: <Fragment set:html={t`(72+84)/2 - (60+64)/2`} />; B: <Fragment set:html={t`(64+84)/2 - (60+72)/2`} />; AB: <Fragment set:html={t`(60+84)/2 - (72+64)/2`} />.</li>
        <li><strong>Answer:</strong> <span class="answer">A = 16, B = 8, AB = 4</span>; as a regression, <Fragment set:html={t`\hat y = 70 + 8x_1 + 4x_2 + 2x_1x_2`} />.</li>
        <li><strong>Why 8 and not 16:</strong> the effect is the rise from <Fragment set:html={t`x_1 = -1`} /> to <Fragment set:html={t`x_1 = +1`} />, a run of 2, so the slope is <Fragment set:html={t`16/2 = 8`} />. It is section 5's <Fragment set:html={t`b_1 = S_{xy}/S_{xx}`} /> too: coded <Fragment set:html={t`x_1`} /> has mean 0, so <Fragment set:html={t`S_{xy} = -60 + 72 - 64 + 84 = 32`} />, <Fragment set:html={t`S_{xx} = 4`} />, and <Fragment set:html={t`32/4 = 8`} />.</li>
      </ol>
      <figure class="fig"><Fragment set:html={doeSvg} /><figcaption>Parallel lines would mean no interaction; these spread apart.</figcaption></figure>
      <p>With one run per cell, the four runs are used up by four estimates (the mean, A, B and AB), leaving no degrees of freedom for error. Is AB = 4 real or noise? This design cannot say.</p>
    </details>
    <details class="full">
      <summary>Worked example: the same experiment, replicated</summary>
      <ol class="steps">
        <li><strong>Data:</strong> two runs per cell, (58, 62), (70, 74), (63, 65), (83, 85); N = 8. The cell averages are still 60, 72, 64, 84, so the effects are still A = 16, B = 8, AB = 4.</li>
        <li><strong>Equations:</strong> pooled <Fragment set:html={t`s^2`} /> = the average of the four cells' variances, with <Fragment set:html={t`4(n-1)`} /> df; each effect is an average of N/2 runs minus another, so <Fragment set:html={t`SE = 2s/\sqrt{N}`} />, and <Fragment set:html={t`t = \text{effect}/SE`} />.</li>
        <li><strong>Fill in:</strong> cell variances 8, 8, 2, 2, so <Fragment set:html={t`s^2 = 20/4 = 5`} />, <Fragment set:html={t`s = 2.236`} />, 4 df; <Fragment set:html={t`SE = 2(2.236)/\sqrt 8 = 1.581`} />; t = 10.12, 5.06 and 2.53, against <Fragment set:html={t`t_{0.025,4} = 2.776`} />.</li>
        <li><strong>Answer:</strong> <span class="answer">A (p &lt; 0.001) and B (p = 0.007) are real; AB (p = 0.065) is not distinguishable from noise</span>. A two-way ANOVA gives the same tests: each F is t², 102.4, 25.6 and 6.4.</li>
      </ol>
    </details>
    <details class="full">
      <summary>Worked example: a third level of time (2×3)</summary>
      <p>Temperature (A) at two levels and time (B) at three, two runs per cell (N = 12, 6 error df):</p>
      <div class="scroll"><table class="num">
        <thead><tr><th></th><th>B low</th><th>B mid</th><th>B high</th><th>row mean</th></tr></thead>
        <tbody>
          <tr><th>A low</th><td>59, 61 → 60</td><td>65, 69 → 67</td><td>63, 65 → 64</td><td>63.67</td></tr>
          <tr><th>A high</th><td>70, 74 → 72</td><td>80, 82 → 81</td><td>83, 85 → 84</td><td>79.00</td></tr>
          <tr><th>column mean</th><td>66</td><td>74</td><td>74</td><td>71.33</td></tr>
        </tbody>
      </table></div>
      <ol class="steps">
        <li><strong>Curvature:</strong> the middle level against the straight line between the ends, <Fragment set:html={t`\bar y_{mid} - (\bar y_{low} + \bar y_{high})/2 = 74 - (66 + 74)/2 = 4`} />. Two levels of time could not have shown it.</li>
        <li><strong>Split B's 2 df</strong> with the contrasts (−1, 0, 1) and (1, −2, 1): <Fragment set:html={t`SS = a\,n\,(\textstyle\sum_j c_j \bar y_j)^2 / \sum_j c_j^2`} />, giving 128 (linear) and 42.67 (curvature), which add to B's 170.67.</li>
      </ol>
      <div class="scroll"><table class="num">
        <thead><tr><th>Source</th><th>SS</th><th>df</th><th>MS</th><th>F</th><th>p</th></tr></thead>
        <tbody>
          <tr><th>A (temperature)</th><td>705.33</td><td>1</td><td>705.33</td><td>176.33</td><td>&lt; 0.001</td></tr>
          <tr><th>B (time)</th><td>170.67</td><td>2</td><td>85.33</td><td>21.33</td><td>0.002</td></tr>
          <tr><th>&nbsp;&nbsp;linear</th><td>128.00</td><td>1</td><td>128.00</td><td>32.00</td><td>0.001</td></tr>
          <tr><th>&nbsp;&nbsp;curvature</th><td>42.67</td><td>1</td><td>42.67</td><td>10.67</td><td>0.017</td></tr>
          <tr><th>AB</th><td>34.67</td><td>2</td><td>17.33</td><td>4.33</td><td>0.068</td></tr>
          <tr><th>Error</th><td>24.00</td><td>6</td><td>4.00</td><td></td><td></td></tr>
        </tbody>
      </table></div>
      <p><strong>Answer:</strong> <span class="answer">temperature and time both matter, time's effect bends (p = 0.017), and the interaction is not significant at 5% (p = 0.068)</span>. Checked against statsmodels' <code>anova_lm</code>.</p>
    </details>
  </section>

