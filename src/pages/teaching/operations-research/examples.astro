---
import Base from "../../../layouts/Base.astro";
import { t, d } from "../../../lib/tex.js";
import { plot, canvas } from "../../../lib/fig.js";
import HessianExplorer from "../../../components/teach/HessianExplorer.astro";
import SimplexExplorer from "../../../components/teach/SimplexExplorer.astro";
import "katex/dist/katex.min.css";
import "../../../styles/examples.css";

/**
 * IE 3315 worked examples (Jones, 2026-10-12): one small problem per core
 * idea, worked step by step, with its figure drawn from the same numbers.
 * Every number here was checked in Python (scipy's HiGHS for the LPs, brute
 * force for the integer program, Gurobi for the global polynomial minimum)
 * before it was written down. IE 5301's page links back to these sections,
 * so keep the section ids stable.
 */

// ---- 1. Product mix, solved graphically, with the simplex path -------------
const lp = plot({ w: 540, h: 420, x: [0, 42], y: [0, 42] })
  .axes({ xt: [0, 10, 20, 30, 40], yt: [0, 10, 20, 30, 40], xl: "x₁  chairs per week", yl: "x₂  tables per week", grid: true })
  .area([[0, 0], [30, 0], [24, 8], [0, 20]])
  .line([[0, 20], [40, 0]], "ln")
  .line([[0, 40], [30, 0]], "ln")
  .text(41.5, 4.2, "labor: x₁ + 2x₂ = 40", { anchor: "end" })
  .text(8.6, 30.5, "wood: 4x₁ + 3x₂ = 120")
  .line([[0, 20], [25, 0]], "dash")
  .line([[0, 27.2], [34, 0]], "dash-a")
  .text(1, 28.6, "z = 1,360", { cls: "accent" })
  .text(17.5, 4.2, "z = 1,000", { anchor: "end" })
  .arrow(0, 0.4, 0, 19.2)
  .arrow(0.8, 19.6, 23.2, 8.4)
  .text(1.2, 10, "step 1")
  .text(12.5, 16.4, "step 2")
  .dot(0, 0, "pt-o").dot(30, 0, "pt-o").dot(0, 20, "pt-o").dot(24, 8, "pt", 6)
  .text(0.9, 1.3, "A", { cls: "strong" })
  .text(30.7, 1.3, "B", { cls: "strong" })
  .text(0.9, 21, "C", { cls: "strong" })
  .text(25.2, 9.4, "D  optimal", { cls: "strong" })
  .text(9, 7, "feasible region", { cls: "note" })
  .svg("Graph of the product-mix LP: the feasible region is the four-sided area with corners (0,0), (30,0), (24,8) and (0,20). The simplex method starts at the origin, moves up to (0,20), then along the labor line to the optimal corner (24,8), where profit is 1,360.");

// KKT cone at the optimal corner: c lies between the two binding constraints' normals.
const n1 = [1, 2], n2 = [4, 3], c = [40, 50];
const unit = (v, L) => { const m = Math.hypot(...v); return [(v[0] / m) * L, (v[1] / m) * L]; };
const [a1, a2, ac] = [unit(n1, 6), unit(n2, 6), unit(c, 7.2)];
// Equal scales on both axes (17.7 px per unit), so each normal looks perpendicular to its line.
const kkt = plot({ w: 420, h: 387, x: [14, 34], y: [0, 18] })
  .axes({ xt: [15, 20, 25, 30], yt: [0, 5, 10, 15], xl: "x₁", yl: "x₂" })
  .area([[14, 0], [30, 0], [24, 8], [14, 13]])
  .line([[14, 13], [34, 3]], "ln")
  .line([[16.5, 18], [30, 0]], "ln")
  .area([[24, 8], [24 + a1[0] * 1.6, 8 + a1[1] * 1.6], [24 + a2[0] * 1.6, 8 + a2[1] * 1.6]], "fill-b")
  .arrow(24, 8, 24 + a1[0], 8 + a1[1]).arrow(24, 8, 24 + a2[0], 8 + a2[1])
  .arrow(24, 8, 24 + ac[0], 8 + ac[1], "arr-m")
  .text(24 + a1[0] - 0.3, 8 + a1[1] + 0.3, "labor normal (1, 2)", { anchor: "end" })
  .text(24 + a2[0] + 0.3, 8 + a2[1] - 0.4, "wood normal (4, 3)")
  .text(24 + ac[0] + 0.3, 8 + ac[1] + 0.3, "c = (40, 50)", { cls: "strong" })
  .dot(24, 8, "pt", 5)
  .text(23.4, 6.6, "(24, 8)", { anchor: "end" })
  .svg("At the optimal corner the objective direction c = (40, 50) points between the outward normals of the two binding constraints, labor (1, 2) and wood (4, 3). That is the KKT condition: c = 16 times (1, 2) plus 6 times (4, 3).");

// ---- 3. Transportation network ---------------------------------------------
const S = [["Plant 1", 50, 60], ["Plant 2", 60, 160], ["Plant 3", 40, 260]];
const D = [["Store A", 70, 105], ["Store B", 80, 215]];
const cost = [[4, 6], [5, 3], [3, 7]], flow = [[30, 20], [0, 60], [40, 0]];
const net = canvas(560, 320);
for (let i = 0; i < 3; i++) for (let j = 0; j < 2; j++) {
  const used = flow[i][j] > 0;
  // Each arc leaves its plant from its own port (Store A's higher, Store B's lower) and lands
  // on its own port at the store. Tags sit a fifth of the way along, where the six arcs are
  // still about 34 px apart, so they line up in a column without touching.
  net.edge(160, S[i][2] + (j === 0 ? -9 : 9), 402, D[j][2] + (i - 1) * 11, {
    cls: used ? "flow" : "arr-m", arrow: used, tag: true, at: 0.2,
    label: used ? `${flow[i][j]} units · $${cost[i][j]}` : `unused · $${cost[i][j]}`,
    lcls: used ? "accent" : "note",
  });
}
S.forEach(([n, s, y]) => net.box(100, y, 112, 46, [n, `supplies ${s}`], "node"));
D.forEach(([n, dd, y]) => net.box(462, y, 112, 46, [n, `needs ${dd}`], "node"));
net.text(100, 306, "supply nodes (+)").text(462, 306, "demand nodes (−)");
const netSvg = net.svg("Transportation network: three plants on the left, two stores on the right, an arc for every plant-store pair labelled with its unit cost. The optimal flows use four arcs: Plant 1 sends 30 to Store A and 20 to Store B, Plant 2 sends 60 to Store B, Plant 3 sends 40 to Store A.");

// ---- 4. Branch and bound -----------------------------------------------------
const bb = canvas(600, 380);
bb.edge(300, 62, 130, 140, { r1: 0, r2: 0, cls: "arr-m", label: "x₂ ≤ 3", lx: -26, ly: 0 })
  .edge(300, 62, 450, 140, { cls: "arr-m", label: "x₂ ≥ 4", lx: 26, ly: 0 })
  .edge(450, 186, 340, 250, { cls: "arr-m", label: "x₁ ≤ 1", lx: -24, ly: 0 })
  .edge(450, 186, 540, 250, { cls: "arr-m", label: "x₁ ≥ 2", lx: 24, ly: 0 })
  .edge(340, 296, 220, 340, { cls: "arr-m", label: "x₂ ≤ 4", lx: -26, ly: -2 })
  .edge(340, 296, 440, 340, { cls: "arr-m", label: "x₂ ≥ 5", lx: 26, ly: -2 })
  .box(300, 40, 190, 46, ["0. LP relaxation", "x = (2.25, 3.75), z = 41.25"], "node")
  .box(130, 162, 190, 46, ["1. x = (3, 3), z = 39", "integer: incumbent 39"], "node")
  .box(450, 162, 170, 46, ["2. x = (1.8, 4)", "z = 41 > 39: branch"], "node")
  .box(340, 272, 180, 46, ["3. x = (1, 4.44)", "z = 40.56 > 39: branch"], "node")
  .box(540, 272, 110, 46, ["4. infeasible", "prune"], "node-m")
  .box(200, 356, 170, 40, ["5. x = (1, 4), z = 37", "37 < 39: prune"], "node-m")
  .box(460, 356, 190, 40, ["6. x = (0, 5), z = 40", "integer, best: optimal"], "node-a");
const bbSvg = bb.svg("Branch-and-bound tree. The LP relaxation gives 41.25 at (2.25, 3.75). Branching on x2 at most 3 gives the integer point (3,3) worth 39. Branching on x2 at least 4 gives 41, then x1 at most 1 gives 40.56; x1 at least 2 is infeasible. Under x1 at most 1, x2 at most 4 gives 37 and is pruned; x2 at least 5 gives the integer point (0,5) worth 40, the optimum.");

const lat = plot({ w: 380, h: 320, x: [0, 7], y: [0, 6] })
  .axes({ xt: [0, 1, 2, 3, 4, 5, 6, 7], yt: [0, 1, 2, 3, 4, 5, 6], xl: "x₁", yl: "x₂", grid: true })
  .area([[0, 0], [6, 0], [2.25, 3.75], [0, 5]]);
for (let a = 0; a <= 7; a++) for (let b = 0; b <= 6; b++)
  if (a + b <= 6 && 5 * a + 9 * b <= 45) lat.dot(a, b, "pt-m", 3);
lat.line([[0, 6], [6, 0]], "ln").line([[0, 5], [7, 10 / 9]], "ln")
  .dot(2.25, 3.75, "pt-o", 5).text(2.45, 3.95, "LP optimum (2.25, 3.75)")
  .dot(2, 4, "pt-w", 4).text(2.15, 4.5, "rounded (2, 4): infeasible", { cls: "warn" })
  .dot(0, 5, "pt", 6).text(1.25, 5.45, "integer optimum (0, 5)", { cls: "strong" })
  .line([[0.12, 5.05], [1.18, 5.38]], "ln-m")
  .line([[0, 5], [7, 0.625]], "dash-a");
const latSvg = lat.svg("The integer program's feasible region with its integer points. The LP optimum (2.25, 3.75) is not an integer point; rounding it to (2, 4) breaks the second constraint; the integer optimum is (0, 5), on the objective line z = 40.");

// ---- 5. Convexity: contours, eigenvectors, Sylvester ------------------------
const r2 = Math.SQRT1_2;
const toXY = (u, w) => [r2 * (u + w), r2 * (u - w)]; // u along (1,1), w along (1,-1)
const inBox = ([x, y]) => Math.abs(x) <= 2 && Math.abs(y) <= 2;
function clipped(pl, pts, cls) {
  let seg = [];
  for (const p of pts) {
    if (inBox(p)) seg.push(p);
    else { if (seg.length > 1) pl.line(seg, cls); seg = []; }
  }
  if (seg.length > 1) pl.line(seg, cls);
}
const conv = plot({ w: 300, h: 300, x: [-2, 2], y: [-2, 2], pad: [24, 12, 34, 34] })
  .axes({ xt: [-2, -1, 0, 1, 2], yt: [-2, -1, 0, 1, 2], xl: "x", yl: "y" });
for (const lev of [0.5, 2, 4.5]) {
  const pts = [];
  for (let k = 0; k <= 120; k++) { const s = (2 * Math.PI * k) / 120; pts.push(toXY(Math.sqrt((2 * lev) / 6) * Math.cos(s), Math.sqrt((2 * lev) / 2) * Math.sin(s))); }
  clipped(conv, pts, "ln-a");
}
conv.arrow(0, 0, ...toXY(1.2, 0)).arrow(0, 0, ...toXY(0, 1.2))
  .text(...toXY(1.45, 0), "λ = 6", { cls: "strong" })
  .text(...toXY(0, 1.5), "λ = 2", { cls: "strong" })
  .text(-1.9, 1.75, "f = 2x² + 2xy + 2y²", { cls: "lab" });
const convSvg = conv.svg("Contours of f = 2x² + 2xy + 2y² are nested ellipses around the minimum at the origin. The eigenvectors of the Hessian are the ellipses' axes: curvature 6 along (1,1), so the ellipses are narrow that way, and curvature 2 along (1,−1), so they are long that way.");

const sad = plot({ w: 300, h: 300, x: [-2, 2], y: [-2, 2], pad: [24, 12, 34, 34] })
  .axes({ xt: [-2, -1, 0, 1, 2], yt: [-2, -1, 0, 1, 2], xl: "x", yl: "y" });
for (const lev of [1, 4, -1, -4]) {
  for (const sign of [1, -1]) {
    const pts = [];
    for (let k = -60; k <= 60; k++) {
      const s = k / 20;
      pts.push(lev > 0
        ? toXY(sign * Math.sqrt(lev / 3) * Math.cosh(s), Math.sqrt(lev) * Math.sinh(s))
        : toXY(Math.sqrt(-lev / 3) * Math.sinh(s), sign * Math.sqrt(-lev) * Math.cosh(s)));
    }
    clipped(sad, pts, lev > 0 ? "ln-a" : "ln-b");
  }
}
// f = 0 where w = ±√3·u: the asymptotes every hyperbola approaches.
for (const m of [Math.sqrt(3), -Math.sqrt(3)]) {
  const pts = [];
  for (let k = -40; k <= 40; k++) pts.push(toXY(k / 20, (m * k) / 20));
  clipped(sad, pts, "dash");
}
sad.arrow(0, 0, ...toXY(1.2, 0)).arrow(0, 0, ...toXY(0, 1.2))
  .text(...toXY(1.45, 0), "λ = 6", { cls: "strong" })
  .text(...toXY(0, 1.5), "λ = −2", { cls: "strong" })
  .text(-1.9, 1.75, "f = x² + 4xy + y²", { cls: "lab" });
const sadSvg = sad.svg("Contours of f = x² + 4xy + y² are hyperbolas: a saddle. Along (1,1) the curvature is 6 and f rises; along (1,−1) it is −2 and f falls. Dashed lines are where f = 0.");

// ---- 6. A nonconvex polynomial ----------------------------------------------
const poly = (x) => x ** 4 - 3 * x ** 2 + x;
const pf = plot({ w: 520, h: 340, x: [-2, 2], y: [-5, 6] })
  .axes({ xt: [-2, -1, 0, 1, 2], yt: [-4, -2, 0, 2, 4, 6], xl: "x", yl: "f(x)", grid: true })
  .fn(poly, -2, 2, "ln-a")
  .dot(-1.3008, -3.5139, "pt", 6).text(-1.0, -4.5, "global minimum  x ≈ −1.30, f ≈ −3.51", { cls: "strong", anchor: "middle" })
  .dot(1.1309, -1.0702, "pt-o", 5).text(1.13, -1.6, "local minimum  x ≈ 1.13, f ≈ −1.07", { anchor: "middle" })
  .dot(0.1699, 0.0841, "pt-m", 3).text(0.17, 0.6, "local maximum", { anchor: "middle" })
  .arrow(1.85, poly(1.85), 1.3, poly(1.3) + 0.15, "arr-m")
  .text(1.95, 4.6, "a local method started at x = 1.85 stops here", { anchor: "end" });
const polySvg = pf.svg("Plot of f(x) = x⁴ − 3x² + x on [−2, 2]: two valleys. The deeper one, at x ≈ −1.30, is the global minimum; a local method started on the right slides into the shallower one at x ≈ 1.13 and stops.");
---

<Base title="IE 3315 Worked Examples" wide={true} description="Operations Research I, worked step by step: an LP solved graphically and by simplex, its dual and shadow prices, KKT, a transportation network, branch and bound, convexity with Hessians, and modern quadratic solvers.">
<div class="ex">
  <p class="crumbs"><a href="/teaching/">Teaching</a> · <a href="/teaching/operations-research/">IE 3315 Operations Research I</a> · Worked examples</p>

  <p>
    One small problem for each core idea in the course, broken down the way it is in class: the idea in
    plain words, the few equations you need, and a worked answer. Where there is a fuller version of the
    math, it comes after the simple one. Two of the sections have something to click.
  </p>
  <ol class="toc">
    <li><a href="#lp">A product-mix LP, graphically and by simplex</a></li>
    <li><a href="#dual">Duality, shadow prices and KKT</a></li>
    <li><a href="#transport">A transportation problem as a network</a></li>
    <li><a href="#bnb">Branch and bound</a></li>
    <li><a href="#convex">Convexity: Hessians and Sylvester's criterion</a></li>
    <li><a href="#qp">Nonconvex problems and modern solvers</a></li>
  </ol>

  <!-- 1 ------------------------------------------------------------------ -->
  <section id="lp">
    <h2>1. A product-mix LP, graphically and by simplex</h2>
    <ul class="able">
      <li>Turn a word problem into variables, an objective and constraints</li>
      <li>Graph the constraints and find the corner points</li>
      <li>Explain how simplex moves from corner to corner</li>
      <li>Report the answer as <Fragment set:html={t`z`} /> and <Fragment set:html={t`x`} /></li>
    </ul>
    <div class="problem">
      <p><strong>Problem.</strong> A shop makes chairs ($40 profit each) and tables ($50). A chair takes 1 hour of
      labor and 4 units of wood; a table takes 2 hours and 3 units. Each week there are 40 hours of labor and
      120 units of wood. What should the shop make?</p>
    </div>

    <h3>Formulate</h3>
    <dl class="defs">
      <dt>Decision variables</dt><dd>What you choose: <Fragment set:html={t`x_1`} /> chairs and <Fragment set:html={t`x_2`} /> tables.</dd>
      <dt>Objective</dt><dd>What you maximize: profit <Fragment set:html={t`z`} />.</dd>
      <dt>Constraints</dt><dd>One per limited resource, plus no negative production.</dd>
    </dl>
    <Fragment set:html={d`\begin{aligned}
      \max\; z = {} & 40x_1 + 50x_2 \\
      \text{s.t.}\; & x_1 + 2x_2 \le 40 && \text{(labor)}\\
      & 4x_1 + 3x_2 \le 120 && \text{(wood)}\\
      & x_1,\ x_2 \ge 0
    \end{aligned}`} />

    <h3>Solve graphically</h3>
    <p>The best answer is always at a corner of the feasible region, so only the corners need checking.</p>
    <ol class="steps">
      <li><strong>Draw each constraint</strong> from its two intercepts. Labor: <Fragment set:html={t`(40, 0)`} /> and <Fragment set:html={t`(0, 20)`} />. Wood: <Fragment set:html={t`(30, 0)`} /> and <Fragment set:html={t`(0, 40)`} />.</li>
      <li><strong>Shade the feasible side</strong> (the origin passes both, so it is the origin's side).</li>
      <li><strong>Find the corners.</strong> Where the two lines cross, solve them together: <Fragment set:html={t`x_1 = 24`} />, <Fragment set:html={t`x_2 = 8`} />.</li>
      <li><strong>Check <Fragment set:html={t`z`} /> at every corner:</strong> A <Fragment set:html={t`(0,0)`} /> 0; B <Fragment set:html={t`(30,0)`} /> 1,200; C <Fragment set:html={t`(0,20)`} /> 1,000; D <Fragment set:html={t`(24,8)`} /> 1,360.</li>
      <li><strong>Answer:</strong> <span class="answer"><Fragment set:html={t`x = (24, 8),\ z = 1{,}360`} /></span>: 24 chairs and 8 tables, $1,360 a week.</li>
    </ol>
    <figure class="fig"><Fragment set:html={lp} />
      <figcaption>The feasible region (shaded) and its corners. The arrows are the path simplex takes, A → C → D. The dashed green line is the profit line z = 1,360, touching the region only at D.</figcaption></figure>

    <h3>The same answer by simplex</h3>
    <p>Simplex is the graphical method done with algebra, so it works with more than two variables:</p>
    <ol class="steps">
      <li><strong>Only look at corner points.</strong></li>
      <li><strong>Start at a feasible corner</strong>, here the origin: make nothing.</li>
      <li><strong>Check: is a neighbouring corner better?</strong> In the table, a negative number in the z row says yes.</li>
      <li><strong>Move to the better corner</strong> (pivot), and repeat until no neighbour is better.</li>
    </ol>
    <p>
      In the table, each <em>basis</em> (the set of variables allowed to be nonzero) is one corner. Adding slack
      variables <Fragment set:html={t`s_1`} /> (spare labor) and <Fragment set:html={t`s_2`} /> (spare wood) turns the constraints into equations,
      and starting with only the slacks in the basis puts you at the origin. Click through it:
    </p>

    <SimplexExplorer />

    <details class="full">
      <summary>The pivots, worked by hand</summary>
      <ol class="steps">
        <li><strong>Corner A.</strong> Basis <Fragment set:html={t`\{s_1, s_2\}`} />: <Fragment set:html={t`s_1 = 40,\ s_2 = 120,\ z = 0`} />. The z row is <Fragment set:html={t`z - 40x_1 - 50x_2 = 0`} />.</li>
        <li><strong>Entering variable:</strong> the most negative z-row number is <Fragment set:html={t`-50`} />, so <Fragment set:html={t`x_2`} /> enters.</li>
        <li><strong>Ratio test (who leaves):</strong> labor <Fragment set:html={t`40/2 = 20`} />, wood <Fragment set:html={t`120/3 = 40`} />. Labor runs out first, so <Fragment set:html={t`s_1`} /> leaves. Pivot to corner C <Fragment set:html={t`(0, 20)`} />, <Fragment set:html={t`z = 1{,}000`} />.</li>
        <li><strong>Again:</strong> the z row is now <Fragment set:html={t`z - 15x_1 + 25s_1 = 1{,}000`} />, so <Fragment set:html={t`x_1`} /> enters. Ratios <Fragment set:html={t`20/0.5 = 40`} /> and <Fragment set:html={t`60/2.5 = 24`} />: wood leaves. Pivot to corner D <Fragment set:html={t`(24, 8)`} />.</li>
        <li><strong>Stop:</strong> the z row is <Fragment set:html={t`z + 16s_1 + 6s_2 = 1{,}360`} />, with nothing negative left. The 16 and 6 are the shadow prices of labor and wood (next section).</li>
      </ol>
    </details>
  </section>

  <!-- 2 ------------------------------------------------------------------ -->
  <section id="dual">
    <h2>2. Duality, shadow prices and KKT</h2>
    <ul class="able">
      <li>Write the dual of an LP</li>
      <li>Read shadow prices and reduced costs</li>
      <li>Use the KKT conditions to confirm a primal and a dual solution are optimal</li>
    </ul>

    <h3>The dual, in four pairings</h3>
    <p>Every LP (the <em>primal</em>) has a twin LP (the <em>dual</em>) that prices its resources. They are linked in pairs:</p>
    <ul>
      <li>Each primal constraint goes with one dual variable, its shadow price <Fragment set:html={t`y_i`} />.</li>
      <li>The primal right-hand side <Fragment set:html={t`b`} /> becomes the dual's costs, and the primal costs <Fragment set:html={t`c`} /> become the dual's right-hand side.</li>
      <li>A max primal gives a min dual.</li>
      <li>The primal's constraint slacks are the dual's reduced costs, and the other way round.</li>
    </ul>
    <p>For the shop, price labor at <Fragment set:html={t`y_1`} /> an hour and wood at <Fragment set:html={t`y_2`} /> a unit:</p>
    <Fragment set:html={d`\begin{aligned}
      \min\; w = {} & 40y_1 + 120y_2 \\
      \text{s.t.}\; & y_1 + 4y_2 \ge 40 && \text{(a chair's resources are worth at least \$40)}\\
      & 2y_1 + 3y_2 \ge 50 && \text{(a table's are worth at least \$50)}\\
      & y_1,\ y_2 \ge 0
    \end{aligned}`} />
    <ul>
      <li><strong>Weak duality:</strong> any feasible primal is at most any feasible dual, <Fragment set:html={t`cx \le by`} />.</li>
      <li><strong>Strong duality:</strong> at the optimum they are equal, <Fragment set:html={t`cx = by`} />. So when the two match, you can stop.</li>
    </ul>
    <p>
      Both products are made, so both dual constraints are tight: <Fragment set:html={t`y_1 + 4y_2 = 40`} /> and <Fragment set:html={t`2y_1 + 3y_2 = 50`} />,
      giving <span class="answer"><Fragment set:html={t`y = (16, 6),\ w = 1{,}360`} /></span>, the same as <Fragment set:html={t`z`} />.
    </p>

    <h3>Shadow prices and reduced costs</h3>
    <dl class="defs">
      <dt>Shadow price</dt><dd>How much the objective improves if a resource's right-hand side <Fragment set:html={t`b`} /> goes up by one. Labor is worth $16 an hour and wood $6 a unit, while the same corner stays optimal (labor 30 to 80 hours, wood 60 to 160 units).</dd>
      <dt>Reduced cost</dt><dd>How much a variable's profit <Fragment set:html={t`c`} /> must improve before it enters the plan. Variables already in the plan have reduced cost 0.</dd>
    </dl>
    <p>
      <strong>Example.</strong> A bench earns $30 and uses 1 hour of labor and 3 units of wood. At the shadow prices its
      resources are worth <Fragment set:html={t`16(1) + 6(3) = 34`} />, so its reduced cost is <Fragment set:html={t`30 - 34 = -4`} />: making one loses $4. It enters
      the plan only if its profit passes $34.
    </p>

    <h3>KKT: how you know you are done</h3>
    <p>The KKT conditions are a test for optimality. For an LP they boil down to three tests:</p>
    <ol class="steps">
      <li><strong>Primal feasibility.</strong> The answer has to obey the constraints. If it isn't feasible, it can't be optimal.</li>
      <li><strong>Dual feasibility.</strong> Same idea for the dual: the prices have to obey the dual's constraints.</li>
      <li><strong>Complementary slackness.</strong> If a constraint has slack, its dual variable is zero. If a dual variable is nonzero, its constraint is binding. The same holds the other way, between variables and reduced costs.</li>
    </ol>
    <p>As equations, that is four lines:</p>
    <Fragment set:html={d`\begin{aligned}
      &Ax \le b,\ \ x \ge 0 && \text{(primal feasibility)}\\
      &A^\top y \ge c,\ \ y \ge 0 && \text{(dual feasibility)}\\
      &y\,(b - Ax) = 0 && \text{(complementary slackness)}\\
      &x\,(c - A^\top y) = 0 && \text{(complementary slackness)}
    \end{aligned}`} />
    <p>Plug in <Fragment set:html={t`x = (24, 8)`} /> and <Fragment set:html={t`y = (16, 6)`} />:</p>
    <div class="scroll"><table class="num left">
      <thead><tr><th>Equation</th><th>Plug in</th><th>Holds?</th></tr></thead>
      <tbody>
        <tr><td><Fragment set:html={t`Ax \le b`} /></td><td>labor <Fragment set:html={t`24 + 2(8) = 40 \le 40`} />; wood <Fragment set:html={t`4(24) + 3(8) = 120 \le 120`} /></td><td>yes</td></tr>
        <tr><td><Fragment set:html={t`A^\top y \ge c`} /></td><td>chair <Fragment set:html={t`16 + 4(6) = 40 \ge 40`} />; table <Fragment set:html={t`2(16) + 3(6) = 50 \ge 50`} /></td><td>yes</td></tr>
        <tr><td><Fragment set:html={t`y(b - Ax) = 0`} /></td><td><Fragment set:html={t`16(40 - 40) + 6(120 - 120) = 0`} /></td><td>yes</td></tr>
        <tr><td><Fragment set:html={t`x(c - A^\top y) = 0`} /></td><td><Fragment set:html={t`24(40 - 40) + 8(50 - 50) = 0`} /></td><td>yes</td></tr>
      </tbody>
    </table></div>
    <p>All four hold, so both answers are optimal: <span class="answer"><Fragment set:html={t`z = w = 1{,}360`} /></span>.</p>
    <p><strong>When is KKT enough?</strong></p>
    <ul>
      <li>The conditions are always <em>necessary</em>: if they fail, the answer is not optimal.</li>
      <li>For convex problems, including every LP, they are also <em>sufficient</em>: if they hold, the answer is optimal.</li>
      <li>For nonconvex problems they are only necessary: an answer can pass and still not be the best (section 6).</li>
    </ul>

    <details class="full">
      <summary>The full KKT conditions, for nonlinear problems</summary>
      <p>For <Fragment set:html={t`\max f(x)`} /> subject to <Fragment set:html={t`g_i(x) \le b_i`} />, the dual variables become multipliers <Fragment set:html={t`\lambda_i`} />, and dual feasibility becomes <em>stationarity</em>:</p>
      <Fragment set:html={d`\begin{aligned}
        &\text{stationarity:} && \nabla f(x^*) = \textstyle\sum_i \lambda_i \nabla g_i(x^*)\\
        &\text{primal feasibility:} && g_i(x^*) \le b_i\\
        &\text{dual feasibility:} && \lambda_i \ge 0\\
        &\text{complementary slackness:} && \lambda_i\,\big(b_i - g_i(x^*)\big) = 0
      \end{aligned}`} />
      <p>
        For the shop, stationarity reads <Fragment set:html={t`(40, 50) = 16\,(1, 2) + 6\,(4, 3)`} />: the objective's direction is a
        positive mix of the binding constraints' directions, so no feasible move improves it.
      </p>
      <figure class="fig"><Fragment set:html={kkt} />
        <figcaption>Stationarity at the optimal corner: the objective direction c lies inside the cone (shaded) of the two binding constraints' normals.</figcaption></figure>
      <p>
        A nonlinear example: <Fragment set:html={t`\min (x-3)^2 + (y-2)^2`} /> subject to <Fragment set:html={t`x + y \le 4`} />. Stationarity gives
        <Fragment set:html={t`2(x-3) + \lambda = 0`} /> and <Fragment set:html={t`2(y-2) + \lambda = 0`} />. With the constraint binding,
        <Fragment set:html={t`x^* = (2.5,\ 1.5)`} /> and <Fragment set:html={t`\lambda = 1 \ge 0`} />. The objective is convex, so this is the global minimum.
      </p>
    </details>
  </section>

  <!-- 3 ------------------------------------------------------------------ -->
  <section id="transport">
    <h2>3. A transportation problem as a network</h2>
    <ul class="able">
      <li>Write the standard transportation formulation</li>
      <li>Draw it as a network of supply and demand nodes</li>
      <li>Solve it and check it is optimal</li>
    </ul>
    <div class="problem">
      <p><strong>Problem.</strong> Three plants supply 50, 60 and 40 units; two stores need 70 and 80. Ship everything at least cost.</p>
      <div class="scroll"><table class="num">
        <thead><tr><th></th><th>Store A</th><th>Store B</th><th>Supply</th></tr></thead>
        <tbody>
          <tr><td>Plant 1</td><td>$4</td><td>$6</td><td>50</td></tr>
          <tr><td>Plant 2</td><td>$5</td><td>$3</td><td>60</td></tr>
          <tr><td>Plant 3</td><td>$3</td><td>$7</td><td>40</td></tr>
          <tr><td>Demand</td><td>70</td><td>80</td><td>150 = 150</td></tr>
        </tbody>
      </table></div>
    </div>

    <h3>Formulate</h3>
    <p>Every transportation problem has the same form: ship <Fragment set:html={t`x_{ij}`} /> from supplier <Fragment set:html={t`i`} /> to customer <Fragment set:html={t`j`} />, at cost <Fragment set:html={t`c_{ij}`} /> each.</p>
    <Fragment set:html={d`\min \sum_{i,j} c_{ij}x_{ij} \quad\text{s.t.}\quad \sum_j x_{ij} = \text{supply}_i,\quad \sum_i x_{ij} = \text{demand}_j,\quad x_{ij} \ge 0`} />
    <p>
      Here supply equals demand (150 = 150), so every constraint is an equation. As a network, each plant and
      store is a node and each <Fragment set:html={t`x_{ij}`} /> is an arc. Whole-number supplies and demands give a whole-number answer,
      with no integer constraints needed.
    </p>

    <h3>Solve</h3>
    <ol class="steps">
      <li><strong>Cheapest arcs first.</strong> Plant 2 to B costs $3: send 60. Plant 3 to A costs $3: send 40.</li>
      <li><strong>Fill what is left.</strong> A needs 30 more and B 20 more; only Plant 1 has supply left. Send 30 to A and 20 to B.</li>
      <li><strong>Cost:</strong> <span class="answer"><Fragment set:html={t`60(3) + 40(3) + 30(4) + 20(6) = 540`} /></span>.</li>
      <li><strong>Check it is optimal.</strong> Give each plant a price <Fragment set:html={t`u_i`} /> and each store <Fragment set:html={t`v_j`} /> with <Fragment set:html={t`u_i + v_j = c_{ij}`} /> on the used arcs (<Fragment set:html={t`u_1 = 0`} />, so <Fragment set:html={t`v_A = 4,\ v_B = 6,\ u_2 = -3,\ u_3 = -1`} />). The unused arcs' reduced costs <Fragment set:html={t`c_{ij} - u_i - v_j`} /> are 4 (Plant 2 to A) and 2 (Plant 3 to B). Both positive, so no reroute saves money.</li>
    </ol>
    <figure class="fig"><Fragment set:html={netSvg} />
      <figcaption>The optimal plan as a network: four arcs carry flow, for a total cost of $540.</figcaption></figure>
  </section>

  <!-- 4 ------------------------------------------------------------------ -->
  <section id="bnb">
    <h2>4. Branch and bound</h2>
    <ul class="able">
      <li>Solve the LP relaxation of an integer program</li>
      <li>Branch on a fractional variable</li>
      <li>Prune branches, and know when you are done</li>
    </ul>
    <div class="problem">
      <p><strong>Problem.</strong> Maximize <Fragment set:html={t`z = 5x_1 + 8x_2`} /> subject to <Fragment set:html={t`x_1 + x_2 \le 6`} /> and <Fragment set:html={t`5x_1 + 9x_2 \le 45`} />, with <Fragment set:html={t`x_1, x_2`} /> whole numbers.</p>
    </div>
    <h3>The recipe</h3>
    <ol class="steps">
      <li><strong>Relax:</strong> drop "whole number" and solve the LP. Its <Fragment set:html={t`z`} /> is a bound: no integer answer can beat it.</li>
      <li><strong>Branch:</strong> if a variable is fractional, say <Fragment set:html={t`x_2 = 3.75`} />, split into <Fragment set:html={t`x_2 \le 3`} /> and <Fragment set:html={t`x_2 \ge 4`} />.</li>
      <li><strong>Prune</strong> a branch if it is infeasible, if its answer is already whole numbers (keep the best one, the <em>incumbent</em>), or if its bound is no better than the incumbent.</li>
      <li><strong>Stop</strong> when no branches are left. The incumbent is optimal.</li>
    </ol>
    <h3>Why not just round?</h3>
    <p>
      The LP answer is <Fragment set:html={t`(2.25, 3.75)`} />, <Fragment set:html={t`z = 41.25`} />. Rounding to <Fragment set:html={t`(2, 4)`} /> breaks the second
      constraint (<Fragment set:html={t`46 > 45`} />); rounding down to <Fragment set:html={t`(2, 3)`} /> earns only 34. The real answer is elsewhere.
    </p>
    <figure class="fig"><Fragment set:html={latSvg} />
      <figcaption>The LP region and its whole-number points. The best whole-number point, (0, 5), is not near the LP optimum.</figcaption></figure>
    <h3>The tree</h3>
    <ol class="steps">
      <li>Node 0: <Fragment set:html={t`(2.25, 3.75)`} />, 41.25. Branch on <Fragment set:html={t`x_2`} />.</li>
      <li>Node 1 (<Fragment set:html={t`x_2 \le 3`} />): <Fragment set:html={t`(3, 3)`} />, 39. Whole numbers: incumbent 39.</li>
      <li>Node 2 (<Fragment set:html={t`x_2 \ge 4`} />): <Fragment set:html={t`(1.8, 4)`} />, 41. Beats 39: branch on <Fragment set:html={t`x_1`} />.</li>
      <li>Node 3 (<Fragment set:html={t`x_1 \le 1`} />): <Fragment set:html={t`(1, 4.44)`} />, 40.56. Branch again. Node 4 (<Fragment set:html={t`x_1 \ge 2`} />): infeasible, prune.</li>
      <li>Node 5 (<Fragment set:html={t`x_2 \le 4`} />): <Fragment set:html={t`(1, 4)`} />, 37 &lt; 39, prune. Node 6 (<Fragment set:html={t`x_2 \ge 5`} />): <Fragment set:html={t`(0, 5)`} />, 40, whole numbers and better than 39.</li>
      <li>Nothing left to branch: <span class="answer"><Fragment set:html={t`x = (0, 5),\ z = 40`} /></span>.</li>
    </ol>
    <figure class="fig"><Fragment set:html={bbSvg} />
      <figcaption>The branch-and-bound tree: seven LPs prove the answer without listing every whole-number point.</figcaption></figure>
  </section>

  <!-- 5 ------------------------------------------------------------------ -->
  <section id="convex">
    <h2>5. Convexity: Hessians and Sylvester's criterion</h2>
    <ul class="able">
      <li>Tell when a problem is nonlinear</li>
      <li>Build the Hessian of a function</li>
      <li>Find the leading principal minors and apply Sylvester's criterion</li>
      <li>Decide whether the objective and every constraint are convex</li>
    </ul>
    <dl class="defs">
      <dt>Convex</dt><dd>Shaped like a bowl: a line between any two points on the graph stays on or above it.</dd>
      <dt>Why it matters</dt><dd>In a convex problem (convex objective to minimize, convex constraints), any local minimum is the global minimum.</dd>
      <dt>Hessian</dt><dd>The matrix of second derivatives, <Fragment set:html={t`H_{ij} = \partial^2 f / \partial x_i \partial x_j`} />.</dd>
    </dl>
    <h3>The recipe</h3>
    <ol class="steps">
      <li><strong>Build the Hessian.</strong></li>
      <li><strong>Take the leading principal minors:</strong> <Fragment set:html={t`D_1 = H_{11}`} />, then <Fragment set:html={t`D_2 = H_{11}H_{22} - H_{12}^2`} />, and so on.</li>
      <li><strong>Apply Sylvester's criterion:</strong>
        <ul>
          <li>all <Fragment set:html={t`D_k > 0`} />: positive definite, convex (a bowl);</li>
          <li>signs alternate, starting negative: negative definite, concave (a dome);</li>
          <li>anything else: check every principal minor, not just the leading ones. All of them at least 0 still means convex (positive semidefinite); otherwise it is not convex, and mixed signs mean a saddle.</li>
        </ul></li>
    </ol>
    <h3>Two examples</h3>
    <Fragment set:html={d`\text{A: } f = 2x^2 + 2xy + 2y^2,\ \ H = \begin{bmatrix} 4 & 2 \\ 2 & 4 \end{bmatrix} \qquad \text{B: } f = x^2 + 4xy + y^2,\ \ H = \begin{bmatrix} 2 & 4 \\ 4 & 2 \end{bmatrix}`} />
    <ul>
      <li><strong>A:</strong> <Fragment set:html={t`D_1 = 4 > 0`} />, <Fragment set:html={t`D_2 = 16 - 4 = 12 > 0`} />. <span class="answer">Convex</span></li>
      <li><strong>B:</strong> <Fragment set:html={t`D_1 = 2 > 0`} /> but <Fragment set:html={t`D_2 = 4 - 16 = -12 < 0`} />. <span class="answer">Not convex: a saddle</span></li>
    </ul>
    <p>
      The eigenvalues say the same thing: A has 6 and 2 (both positive), B has 6 and −2 (mixed). In the picture,
      the eigenvectors are the axes of the contours.
    </p>
    <figure class="fig pair">
      <Fragment set:html={convSvg} />
      <Fragment set:html={sadSvg} />
      <figcaption>Left: A's contours are ellipses (a bowl). Right: B's are hyperbolas (a saddle). The arrows are the Hessian's eigenvectors.</figcaption>
    </figure>

    <HessianExplorer />
  </section>

  <!-- 6 ------------------------------------------------------------------ -->
  <section id="qp">
    <h2>6. Nonconvex problems and modern solvers</h2>
    <ul class="able">
      <li>Spot a nonconvex objective or constraint</li>
      <li>Lift a polynomial into a quadratic by adding variables</li>
      <li>Approximate other nonlinear terms with a Taylor series or pieces</li>
    </ul>
    <p>
      If a problem is not convex, a local solver can stop in the wrong valley. Two tricks turn it into something a
      modern solver (Gurobi, SCIP, BARON) can solve to a <strong>proven global optimum</strong>:
    </p>
    <ul>
      <li><strong>Lift polynomials into quadratics.</strong> Give each product its own variable. For <Fragment set:html={t`x^4`} />, let <Fragment set:html={t`w = x^2`} />, then <Fragment set:html={t`x^4 = w^2`} />. Every term is now at most quadratic, which these solvers handle exactly.</li>
      <li><strong>Approximate the rest.</strong> Functions like <Fragment set:html={t`e^x`} /> or <Fragment set:html={t`\log x`} /> can be replaced by a Taylor series near the answer, or by straight-line pieces.</li>
    </ul>
    <h3>Example</h3>
    <Fragment set:html={d`\min_{-2 \le x \le 2}\; f(x) = x^4 - 3x^2 + x`} />
    <ol class="steps">
      <li><strong>Is it convex?</strong> <Fragment set:html={t`f''(x) = 12x^2 - 6`} /> is negative near 0. No.</li>
      <li><strong>Two valleys:</strong> <Fragment set:html={t`x \approx -1.30`} /> (<Fragment set:html={t`f \approx -3.51`} />) and <Fragment set:html={t`x \approx 1.13`} /> (<Fragment set:html={t`f \approx -1.07`} />). A local method started on the right stops at the shallow one, and KKT holds there too.</li>
      <li><strong>Lift:</strong> <Fragment set:html={t`\min\ w^2 - 3w + x`} /> subject to <Fragment set:html={t`w = x^2`} />, <Fragment set:html={t`-2 \le x \le 2`} />.</li>
      <li><strong>Solve globally</strong> (Gurobi, <code>NonConvex=2</code>): <span class="answer"><Fragment set:html={t`x^* = -1.3008,\ f^* = -3.5139`} /></span>, with a proof that nothing is lower.</li>
    </ol>
    <figure class="fig"><Fragment set:html={polySvg} />
      <figcaption>Two valleys. A local method finds the one it starts in; a global solver finds the deeper one and proves it.</figcaption></figure>
    <details class="full">
      <summary>How the global solvers do it</summary>
      <p>
        They use spatial branch and bound: the same tree as section 4, but branching on ranges of a continuous
        variable. Each product such as <Fragment set:html={t`xy`} /> is bounded by a convex relaxation (McCormick envelopes), which gives the
        bounds that let branches be pruned. Tight bounds on every variable make this much faster. Gurobi has solved
        nonconvex quadratic problems this way since version 9, and recent versions also take functions such as
        <Fragment set:html={t`e^x`} /> directly.
      </p>
    </details>
  </section>

