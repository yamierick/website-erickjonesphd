---
import Base from "../layouts/Base.astro";

/**
 * The index is meant to be read, not just clicked through. Each model here
 * exists to make exactly one mechanism visible, so the card states that
 * mechanism rather than describing the interface — a visitor should be able to
 * tell which model answers their question without opening either.
 *
 * The thumbnails are hand-drawn abstractions of each model's actual chart, not
 * screenshots. Screenshots would go stale the moment a model changed, would
 * need regenerating by hand, and would not follow the reader's theme. These are
 * a few hundred bytes, track light and dark, and each one shows the shape that
 * IS the argument: proportions inverting across the cascade, and a supply band
 * arriving too late to close a gap. They are decorative — the card text carries
 * the meaning — so they are hidden from assistive technology rather than given
 * alt text that would only repeat the heading.
 */

// Ore narrowing to metal while the ranking flips: thick copper band thinning
// out, thin steel band thickening, crossing on the way.
const artCascade = `
<svg viewBox="0 0 240 86" class="thumb" aria-hidden="true" focusable="false">
  <path d="M 19 8 C 116 8, 116 30, 214 30 L 214 40 C 116 40, 116 50, 19 50 Z"
        fill="var(--th-copper)" fill-opacity=".55"/>
  <path d="M 19 56 C 116 56, 116 44, 214 44 L 214 72 C 116 72, 116 68, 19 68 Z"
        fill="var(--th-steel)" fill-opacity=".55"/>
  <rect x="14" y="6" width="5" height="64" rx="1.5" fill="var(--th-copper)" fill-opacity=".9"/>
  <rect x="76" y="14" width="5" height="52" rx="1.5" fill="var(--muted)" fill-opacity=".8"/>
  <rect x="148" y="20" width="5" height="46" rx="1.5" fill="var(--muted)" fill-opacity=".8"/>
  <rect x="214" y="28" width="5" height="46" rx="1.5" fill="var(--th-steel)" fill-opacity=".9"/>
</svg>`;

// Demand climbing away from supply, with the recovered band arriving late and
// too small to close the gap it opens.
const artRecovery = `
<svg viewBox="0 0 240 86" class="thumb" aria-hidden="true" focusable="false">
  <path d="M 12 74 L 12 58 L 84 54 L 156 50 L 228 46 L 228 74 Z"
        fill="var(--muted)" fill-opacity=".38"/>
  <path d="M 12 58 L 84 54 L 156 44 L 228 32 L 228 46 L 156 50 L 84 54 Z"
        fill="var(--accent)" fill-opacity=".65"/>
  <path d="M 12 60 L 84 44 L 156 28 L 228 12"
        fill="none" stroke="var(--text)" stroke-width="2" stroke-linejoin="round"/>
  <line x1="12" y1="74" x2="228" y2="74" stroke="var(--rule)" stroke-width="1"/>
</svg>`;

// A staircase and a smooth curve that fits it well, with the stretch where
// they disagree enough to flip the next decision shaded.
const artSurrogate = `
<svg viewBox="0 0 240 86" class="thumb" aria-hidden="true" focusable="false">
  <rect x="58" y="8" width="26" height="66" fill="var(--th-wrong)" fill-opacity=".18"/>
  <rect x="150" y="8" width="22" height="66" fill="var(--th-wrong)" fill-opacity=".18"/>
  <path d="M 12 18 L 70 18 L 70 44 L 160 44 L 160 62 L 228 62"
        fill="none" stroke="var(--text)" stroke-width="2"/>
  <path d="M 12 16 C 48 14, 58 22, 72 32 C 86 42, 120 48, 150 50 C 168 52, 176 60, 228 64"
        fill="none" stroke="var(--accent)" stroke-width="2.2"/>
  <line x1="12" y1="74" x2="228" y2="74" stroke="var(--rule)" stroke-width="1"/>
</svg>`;

const models = [
  {
    title: "What a Grid Is Made Of",
    url: "/materials/",
    art: artCascade,
    line: "Energy demand → the generation that meets it → components → metal → rock.",
    thesis:
      "Copper is a few percent of the metal and the large majority of the rock. Steel dominates "
      + "the tonnage — a wind tower is a very heavy object — while copper, which nobody weighs, "
      + "dominates the mining.",
    detail:
      "Pick a generation mix and it tells you what that mix is made of. Two timescales: over a "
      + "year, the fleet run flat out against annual demand; over one day, the share of demand "
      + "the battery carries.",
  },
  {
    title: "Why Supply Can't Catch Up",
    url: "/supply-gap/",
    art: artRecovery,
    line: "Recycling and new mines, the two ways to add supply, and why neither is quick.",
    thesis:
      "The recovery loop's size was set by packs built ten to fifteen years earlier, so it cannot "
      + "ramp when a shortfall opens. A new mine takes about sixteen years, so for any target inside "
      + "that window the decision is already behind us.",
    detail:
      "Two panels: push demand growth until a gap opens and try to close it with recycling; then "
      + "drag a target year toward the present and watch the required start date slide past today.",
  },
  {
    title: "Accurate, and Still Wrong",
    url: "/linked-models/",
    art: artSurrogate,
    line: "A planning model → a cheap surrogate of it → a supply-chain model that plans on the surrogate.",
    thesis:
      "A surrogate can fit a model's output well and still send the next model to the wrong "
      + "decision, because small errors near a step flip which plants get opened. What matters is "
      + "the decision, not the fit.",
    detail:
      "Add runs and watch the fit improve faster than the decisions do. Where What a Grid Is Made "
      + "Of lets you choose the mix, here a model chooses it.",
  },
];

/**
 * The demos are a different kind of thing from the toys, so they get a section
 * of their own rather than more cards under a disclaimer that says "no number
 * here should be cited". Since 2026-10-11 (Jones) the research demos come
 * first and the teaching toys second, and the page is "Interactives" in the nav (renamed from "Interactive" 2026-10-12). These run on published results, and
 * each folder's test.mjs checks its numbers against the papers' tables.
 *
 * They live as static pages in public/demos/, built outside this repo
 * (Workbench\website\demos). Each card borrows the thumbnail of the project
 * page the demo draws on most, so the image and the project stay in step.
 */
const demos = [
  {
    slug: "mineral-supply-chains", project: "critical-mineral-flows",
    title: "Mineral supply chains",
    line: "Who mines, who refines, and what a cheaper or cleaner plan looks like.",
    body: "Battery metals come from a handful of countries and companies, and most are refined in "
      + "fewer still. What would it cost to plan the chain differently?",
  },
  {
    slug: "battery-recycling", project: "battery-recycling",
    title: "Battery recycling",
    line: "Where to make black mass, and how to make it cheaply.",
    body: "Before any metal comes back out of a spent battery, it has to be ground into a powder "
      + "called black mass. Where should that happen, and does it need expensive equipment?",
  },
  {
    slug: "texas-grid", project: "grid-dashboard",
    title: "The Texas grid",
    line: "Where power is made, where demand is going, and how new loads can power themselves.",
    body: "Texas runs its own grid. As wind, solar and very large new loads arrive, who makes the "
      + "power, and who pays for it?",
  },
  {
    slug: "decarbonizing-travel", project: "sav-hsr",
    title: "Decarbonizing travel",
    line: "Shared self-driving fleets and extended-range EVs.",
    body: "Two ways to take carbon out of car travel: share the cars, or put a bigger battery in "
      + "them. What does each one buy?",
  },
  {
    slug: "food-energy-water", project: "food-energy-water",
    title: "Food, energy and water under climate risk",
    line: "Sharing and co-planning power and water; farming under an unknown climate.",
    body: "Making your own power and water pays when you share it and plan both together. Planning "
      + "for a climate you cannot know costs more than bad weather.",
  },
  {
    slug: "fossil-infrastructure", project: "alternative-energy",
    title: "A second life for fossil-fuel infrastructure",
    line: "Old wells to geothermal, phased CO₂ pipelines, geothermal for data centers.",
    body: "Old oil wells, depleted reservoirs and the skills that built them could carry clean, "
      + "firm power. Where, how fast, and at what cost?",
  },
  {
    slug: "access-and-health", project: "covid-last-mile",
    title: "Access and health",
    line: "Getting COVID-19 vaccines to the neighborhoods that need them.",
    body: "When there are not enough doses to go around, who gets served first, and what does the "
      + "shortage cost?",
  },
];
---

<Base title="Interactives" wide={true} og="models">
  <p class="subhead">The lab's published results, in a form you can move, and a few small teaching models.</p>
  <p class="hint"><a href="#papers">From the lab's papers</a> · <a href="#toys">Teaching models</a></p>

  <h2 class="plain" id="papers">From the lab's papers</h2>
  <p>
    The research itself does not fit on a web page, but its results can. These
    demos are built from published SEAR Lab papers, a few to each theme. Their
    numbers come from the papers' own tables, and tests check them against those
    tables. Where a paper printed a number that later proved wrong, the demo
    shows the corrected value and says so.
  </p>

  <ul class="models demos">
    {demos.map((d) => (
      <li>
        <div class="art"><img src={`/projects/${d.project}/img/thumb.jpg`} alt="" loading="lazy" /></div>
        <h2><a href={`/demos/${d.slug}/`}>{d.title}</a></h2>
        <p class="line">{d.line}</p>
        <p class="thesis">{d.body}</p>
      </li>
    ))}
  </ul>
  <p class="hint">
    <a href="/demos/">All seven on one page</a> ·
    <a href="/projects/">Every SEAR project</a>, with its papers and people
  </p>

  <h2 class="plain" id="toys">Teaching models</h2>
  <p class="disclaimer">
    <strong>These are teaching toys, not research.</strong> They run on fixed
    coefficients, nothing in them is optimized, and no number they produce
    should be cited. What they are good for is the shape of an argument — the
    thing that is hard to see in a table and obvious once you can move it.
  </p>

  <ul class="models">
    {models.map((m) => (
      <li>
        <div class="art"><Fragment set:html={m.art} /></div>
        <h2><a href={m.url}>{m.title}</a></h2>
        <p class="line">{m.line}</p>
        <p class="thesis">{m.thesis}</p>
        <p class="detail">{m.detail}</p>
      </li>
    ))}
  </ul>

  <h3>Where the numbers come from</h3>
  <p>
    Every coefficient in these models says which kind it is — a published
    figure from the IEA, EIA or USGS, or an order-of-magnitude estimate made
    for the page. Roughly a third are estimates. That is fine for arguments
    that turn on ratios of two hundred to one rather than on ten percent
    accuracy, but it is not fine to hide, so the label travels with the number
    and every model carries its figures as a table as well as a picture.
  </p>
  <p>
    Where a model cannot compute something, it says so and does not draw it.
    The day-shape diagram on <a href="/materials/">What a Grid Is Made Of</a>
    is a schematic that deliberately does not respond to the controls, because
    the model underneath has no time resolution and a diagram that reacted to
    the sliders would be claiming to have calculated something it has not.
  </p>
  <p class="hint">
    The real versions of these questions — a mix that is chosen rather than
    given, under capacity limits, lead times and recovery, and models linked
    so one's answer becomes the next one's input — are the actual research. That work lives in <a href="/research/">Research</a> and in
    <a href="/projects/">the projects</a>.
  </p>
</Base>

<style>
  .disclaimer {
    border-left: 3px solid var(--accent);
    padding: .6rem .9rem;
    background: var(--code-bg);
    font-size: .92rem;
  }

  .models {
    list-style: none; padding: 0; margin: 1.5rem 0; display: grid; gap: 1.1rem;
    --th-copper: #9c4f1c;
    --th-steel: #39424b;
    --th-wrong: #b23a2e;
  }
  @media (prefers-color-scheme: dark) {
    .models { --th-copper: #f0b57e; --th-steel: #6b7682; --th-wrong: #f07a6e; }
  }
  @media (min-width: 52rem) {
    .models { grid-template-columns: 1fr 1fr; }
  }

  .models li {
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 0 0 1.1rem;
    overflow: hidden;
    /* The whole card is the click target — see the stretched link below. */
    position: relative;
    transition: border-color .15s ease, background-color .15s ease;
  }
  .models li:hover { border-color: var(--accent); background: var(--code-bg); }

  .art {
    background: var(--code-bg);
    border-bottom: 1px solid var(--rule);
    padding: .5rem .9rem;
  }
  .art :global(svg.thumb) { display: block; width: 100%; height: auto; }
  /* Demo cards use a project photo, full-bleed and cropped to the same strip
     as the drawn thumbnails so the two grids read as one family. */
  .demos .art { padding: 0; }
  .demos .art img { display: block; width: 100%; aspect-ratio: 240 / 86; object-fit: cover; }

  .models h2 { margin: .9rem 1.1rem .3rem; font-size: 1.18rem; }
  .models h2 a { text-decoration: none; }
  .models h2 a:hover { text-decoration: underline; }
  /* Stretched link: one link in the accessibility tree, a whole card to click. */
  .models h2 a::after { content: ""; position: absolute; inset: 0; }

  .models .line {
    font-family: system-ui, sans-serif;
    font-size: .82rem;
    color: var(--muted);
    margin: 0 1.1rem .7rem;
  }
  .models .thesis { margin: 0 1.1rem .6rem; font-size: .96rem; }
  .models .detail {
    font-family: system-ui, sans-serif;
    font-size: .84rem;
    color: var(--muted);
    margin: 0 1.1rem;
  }

  h2.plain { margin-top: 2rem; }
  .hint { font-family: system-ui, sans-serif; font-size: .82rem; color: var(--muted); }
</style>
